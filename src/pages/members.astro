  }
  .faculty-name {
    font-size: 1.25rem;
    font-weight: 800;
    color: #0f172a;
    margin-bottom: 0.4rem;
  }
  .faculty-badge-row {
    margin-bottom: 0.5rem;
  }
  .faculty-title-badge {
    display: inline-block;
    background: #eff6ff;
    color: #2563eb;
