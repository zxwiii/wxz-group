    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.78rem;
    color: #64748b;
    text-decoration: none;
  }
  .faculty-email-link:hover { color: #0284c7; }
  .icon-mail { width: 14px; height: 14px; }
  .faculty-home-btn {
    padding: 0.25rem 0.65rem;
    background: #eff6ff;
    color: #2563eb;
    border-radius: 6px;
    font-size: 0.8rem;
