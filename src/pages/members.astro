    background: linear-gradient(135deg, #0f2c59 0%, #1e3a8a 100%);
    color: #ffffff;
    padding: 3.5rem 1.5rem 2.8rem 1.5rem;
    text-align: center;
  }
  .page-title-cn {
    font-size: 2.3rem;
    font-weight: 800;
    letter-spacing: -0.5px;
    margin: 0 0 0.5rem 0;
  }
  .page-subtitle-cn {
    font-size: 1.05rem;
    color: #bfdbfe;
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.6;
  }
  .members-main-wrap {
    max-width: 1240px;
    margin: 2rem auto 4rem auto;
    padding: 0 1.5rem;
  }
  .anchor-bar {
    display: flex;
    gap: 10px;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
