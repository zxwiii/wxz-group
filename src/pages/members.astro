    display: flex;
    align-items: center;
    gap: 12px;
  }
  .count-tag-pi {
    background: #fef3c7;
    color: #92400e;
    border: 1px solid #fde68a;
    font-size: 0.85rem;
    font-weight: 700;
    padding: 0.2rem 0.75rem;
    border-radius: 20px;
  }
  .count-pill {
    font-size: 0.85rem;
    font-weight: 700;
