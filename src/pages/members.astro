---
import Layout from '../layouts/Layout.astro';
import membersData from '../data/members.json';

// Filter members
const piMember = membersData.find(m => m.category === '教师' && m.name.includes('王小治'));
const teachers = membersData.filter(m => m.category === '教师' && !m.name.includes('王小治'));
const students = membersData.filter(m => m.category === '在读学生');
const alumni = membersData.filter(m => m.category === '历届校友').map(a => {
  let desc = a.education || '';
  desc = desc.replace(/\.[a-zA-Z0-9_\-]+\s*\{[^}]*\}/g, '');
  desc = desc.replace(/\{[^}]*\}/g, '');
  desc = desc.replace(/[a-zA-Z0-9_\-]+:[^;]+;/g, '');
  desc = desc.replace(/王小治课题组.*/g, '');
  desc = desc.replace(/Issuing time:.*/g, '');
  desc = desc.replace(/[\)）]/g, '').trim();
  if (desc.length < 3) desc = '扬州大学环境科学与工程学院毕业生';
  return { ...a, cleanDesc: desc };
});

function formatStudentEdu(eduStr: string) {
  if (!eduStr || eduStr.trim().length < 3) return [];
  const parts = eduStr.split(/(?:[;；\n]|(?<=[^-\d])(?=\d{4}\.\d{2}-))/);
  return parts.map(p => p.trim().replace(/^[，, ；;]+/, '')).filter(p => p.length > 2);
}
---

<Layout title="团队成员" activeNav="members">
  <div class="page-title-banner">
    <h1 class="page-title-cn">团队成员</h1>
  </div>

  <main class="members-main-wrap">
    <!-- 快捷中文锚点条 -->
    <div class="anchor-bar">
      <a href="#pi" class="anchor-link">课题组负责人 / PI</a>
      <a href="#teachers" class="anchor-link">骨干教师 ({teachers.length} 位)</a>
      <a href="#students" class="anchor-link">在读研究生 ({students.length} 位)</a>
      <a href="#alumni" class="anchor-link">历届校友 ({alumni.length} 位)</a>
    </div>

    <!-- 1. PI 单独首行大卡片 -->
    <div id="pi" class="section-head-divider">
      <div class="section-head-title">
        课题组负责人
        <span class="count-tag-pi">PI</span>
      </div>
    </div>
    {piMember && (
      <div class="pi-card">
        <div class="pi-avatar">
          <img src="/images/wangxiaozhi_profile.webp" alt={piMember.name} />
        </div>
        <div class="pi-content">
          <div class="pi-top">
            <div class="pi-name-group">
              <span class="pi-name">{piMember.name}</span>
              <span class="pi-role-tag">课题组负责人 / PI</span>
              <span class="pi-title-badge">教授 · 博士生导师</span>
            </div>
            <a href={piMember.homepage_url} target="_blank" rel="noopener noreferrer" class="pi-link-btn">
              个人官方主页 ↗
            </a>
          </div>
          <div class="pi-unit">扬州大学环境科学与工程学院 · 农业资源与环境学科带头人</div>
          <div class="pi-research">
            <strong>研究方向：</strong>{piMember.research}
          </div>
          <div class="pi-intro">
            {piMember.education}
          </div>
          <div class="pi-contact">
            <span>电子邮箱：<a href={`mailto:${piMember.email}`}>{piMember.email}</a></span>
            <span>办公地点：扬州大学文汇路校区</span>
          </div>
        </div>
      </div>
    )}

    <!-- 2. 骨干教师 4 列名片网格 (严格复刻用户图 3) -->
    <div id="teachers" class="section-head-divider">
      <div class="section-head-title">
        骨干教师团队
        <span class="count-pill">{teachers.length} 位</span>
      </div>
    </div>
    <div class="teachers-grid-four">
      {teachers.map(t => (
        <div class="faculty-card-modern">
          <div class="faculty-avatar-circle">
            <img src={t.avatar_url} alt={t.name} />
          </div>
          <div class="faculty-name">{t.name}</div>
          <div class="faculty-badge-row">
            <span class="faculty-title-badge">{t.title}</span>
          </div>
          <div class="faculty-unit">扬州大学</div>
          <div class="faculty-research">{t.research}</div>
          <div class="faculty-card-bottom">
            <a href={`mailto:${t.email}`} class="faculty-email-link" title={t.email}>
              <svg class="icon-mail" viewBox="0 0 24 24"><path fill="currentColor" d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
              <span>{t.email.split('@')[0]}@...</span>
            </a>
            <a href={t.homepage_url} target="_blank" rel="noopener noreferrer" class="faculty-home-btn">
              个人主页 ›
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- 3. 在读研究生 3 列网格 (修复断行) -->
    <div id="students" class="section-head-divider">
      <div class="section-head-title">
        在读研究生
        <span class="count-pill">{students.length} 位</span>
      </div>
    </div>
    <div class="students-grid-three">
      {students.map(s => {
        const eduList = formatStudentEdu(s.education);
        const researchText = s.research && s.research !== '无' && s.research !== '暂无' ? s.research : '在读相关课题研究';
        const emailText = s.email || '未公开';
        return (
          <div class="student-card-modern">
            <div class="student-head-row">
              <div class="student-avatar-wrap">
                <img src={s.avatar_url} alt={s.name} />
              </div>
              <div class="student-identity">
                <div class="student-name-text">
                  {s.name}
                  <span class="student-grade-pill">{s.grade}</span>
                </div>
                <div class="student-status-text">{s.phone_or_status}</div>
              </div>
            </div>

            <div class="student-field-row">
              <span class="field-title">研究方向：</span>{researchText}
            </div>

            <div class="student-edu-container">
              <div class="edu-header">教育与培养经历</div>
              <div class="edu-body">
                {eduList.length > 0 ? (
                  eduList.map(item => (
                    <div class="edu-item">
                      <span class="edu-dot">•</span> {item}
                    </div>
                  ))
                ) : (
                  <div class="edu-placeholder">暂无详细经历记录</div>
                )}
              </div>
            </div>

            <div class="student-card-footer">
              <svg class="icon-mail-gray" viewBox="0 0 24 24"><path fill="currentColor" d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
              <span>{emailText}</span>
            </div>
          </div>
        );
      })}
    </div>

    <!-- 4. 历届校友 (无凡科垃圾代码) -->
    <div id="alumni" class="section-head-divider">
      <div class="section-head-title">
        历届校友
        <span class="count-pill">{alumni.length} 位</span>
      </div>
    </div>
    <div class="alumni-grid-clean">
      {alumni.map(a => (
        <div class="alumni-card-clean">
          <div class="alumni-top-line">
            <span class="alumni-name-txt">{a.name}</span>
            <span class="alumni-year-pill">{a.grade}</span>
          </div>
          <div class="alumni-desc-txt">
            {a.cleanDesc}
          </div>
        </div>
      ))}
    </div>
  </main>
</Layout>

<style>
