---
import Layout from '../layouts/Layout.astro';
import { membersData } from '../data/members.js';

// 排序辅助函数
function getGradeNum(text: any) {
  if (!text) return 0;
  const m = String(text).match(/\d{4}/);
  return m ? parseInt(m[0], 10) : 0;
}

// 严格按照用户指定规则过滤与排序
const piMember = membersData.find(m => m.category === '教师' && m.name.includes('王小治'));
// 教师：严格保持当前在 CSV 中的排序
const teachers = membersData.filter(m => m.category === '教师' && !m.name.includes('王小治'));
// 在读学生：以 p_ 开头（博士生）置顶，其余按年级降序排序（高年级/入学早的在下面）
const students = membersData
  .filter(m => m.category === '在读研究生')
  .sort((a, b) => {
    const aIsP = a.id.startsWith('p_') ? 0 : 1;
    const bIsP = b.id.startsWith('p_') ? 0 : 1;
    if (aIsP !== bIsP) return aIsP - bIsP;
    return getGradeNum(b.grade || b.title) - getGradeNum(a.grade || a.title);
  });
// 校友：按年级降序排序（年级大的在下面，2023级在上，2008级在最底）
const alumni = membersData
  .filter(m => m.category === '校友')
  .sort((a, b) => getGradeNum(b.grade || b.title) - getGradeNum(a.grade || a.title));

// 教育经历结构化辅助函数（带双重防断行保护）
function getEduList(m: any) {
  let list: string[] = [];
  if (m.education_list && Array.isArray(m.education_list) && m.education_list.length > 0) {
    list = m.education_list;
  } else if (m.education && typeof m.education === 'string' && m.education.trim().length >= 3) {
    const cleaned = m.education.replace(/([-\u2013\u2014~至])\s*[\r\n]+\s*/g, '$1');
    const rawParts = cleaned.split(/[\r\n]+/);
    for (const p of rawParts) {
      const sub = p.split(/(?<![-\u2013\u2014~至\d])(?=(?:19|20)\d{2}[.\-年/])/);
      for (const s of sub) {
        const trimmed = s.trim().replace(/^[，, ；;]+|[，, ；;]+$/g, '');
        if (trimmed.length > 2) list.push(trimmed);
      }
    }
  }

  // 双重保护：若某项以连字符结尾，自动与下一行合并，彻底杜绝年份断行
  const merged: string[] = [];
  for (let i = 0; i < list.length; i++) {
    const cur = list[i].trim();
    if (/[-\u2013\u2014~至]$/.test(cur) && i + 1 < list.length) {
      merged.push(cur + list[i + 1].trim());
      i++;
    } else {
      merged.push(cur);
    }
  }
  return merged;
}

// 格式化学习经历：提取日期范围并强制不换行 (white-space: nowrap)
function renderEduItem(text: string) {
  const m = text.match(/^((?:19|20)\d{2}[.\-年/]\d{1,2}(?:日)?\s*[-\u2013\u2014~至]\s*(?:(?:19|20)\d{2}[.\-年/]\d{1,2}(?:日)?|至今|现在))([，, \s]*.*)$/);
  if (m) {
    return { date: m[1].replace(/\s+/g, ''), desc: m[2] };
  }
  return { date: '', desc: text };
}
---

<Layout title="团队成员 - 王小治课题组" activeNav="members">
  <div class="page-title-banner">
    <h1 class="page-title-cn">团队成员</h1>
    <p class="page-subtitle-cn">汇聚环境科学、催化化学与生态工程前沿领域的师生与青年创新人才</p>
  </div>

  <main class="members-main-wrap">
    <!-- 快捷中文锚点条 -->
    <div class="anchor-bar">
      <a href="#pi" class="anchor-link">课题组负责人 / PI</a>
      <a href="#teachers" class="anchor-link">教师 ({teachers.length} 位)</a>
      <a href="#students" class="anchor-link">在读研究生 ({students.length} 位)</a>
      <a href="#alumni" class="anchor-link">毕业校友 ({alumni.length} 位)</a>
    </div>

    <!-- 1. PI 单独首行大卡片 -->
    <div id="pi" class="section-head-divider">
      <div class="section-head-title">
        课题组负责人
        <span class="count-tag-pi">PI</span>
      </div>
    </div>
    {piMember && (
      <div class="pi-card">
        <a href="/faculty/wangxiaozhi" class="pi-avatar-link" title="点击查看王小治教授学术主页">
          <div class="pi-avatar">
            <img 
              src={piMember.avatar_url || '/images/members/wangxiaozhi.jpg'} 
              alt={piMember.name}
              onerror="this.src='/images/members/default_avatar.jpg'" 
            />
          </div>
        </a>
        <div class="pi-content">
          <div class="pi-top">
            <div class="pi-name-group">
              <a href="/faculty/wangxiaozhi" class="pi-name-link" title="点击查看王小治教授学术主页">
                <span class="pi-name">{piMember.name}</span>
              </a>
              <span class="pi-role-tag">课题组负责人 / PI</span>
              <span class="pi-title-badge">{piMember.title}</span>
            </div>
            <div class="pi-links-group">
              <a href="/faculty/wangxiaozhi" class="pi-link-btn primary" title="查看王小治教授详细学者主页">
                学术详细简介 ›
              </a>
            </div>
          </div>
          <div class="pi-unit">扬州大学环境科学与工程学院 · 农业资源与环境学科带头人</div>
          <div class="pi-research">
            <strong>研究方向：</strong>{piMember.research}
          </div>
          {piMember.education && (
            <div class="pi-intro">
              {piMember.education}
            </div>
          )}
          <div class="pi-contact">
            {piMember.email && (
              <span>电子邮箱：<a href={`mailto:${piMember.email}`}>{piMember.email}</a></span>
            )}
            {piMember.phone && (
              <span>联系电话：<a href={`tel:${piMember.phone}`}>{piMember.phone}</a></span>
            )}
            <span>办公地点：扬州大学扬子津校区学行楼</span>
          </div>
        </div>
      </div>
    )}

    <!-- 2. 教师 4 列名片网格 -->
    <div id="teachers" class="section-head-divider">
      <div class="section-head-title">
        教师
        <span class="count-pill">{teachers.length} 位</span>
      </div>
    </div>
    <div class="teachers-grid-four">
      {teachers.map(t => (
        <div class="faculty-card-modern">
          <div class="faculty-avatar-circle">
            <img 
              src={t.avatar_url || '/images/members/default_avatar.jpg'} 
              alt={t.name}
              onerror="this.src='/images/members/default_avatar.jpg'"
            />
          </div>
          <div class="faculty-name">{t.name}</div>
          <div class="faculty-badge-row">
            <span class="faculty-title-badge">{t.title}</span>
          </div>
          <div class="faculty-unit">扬州大学环境科学与工程学院</div>
          <div class="faculty-research">{t.research || '农业资源与环境、环境科学与工程'}</div>
          <div class="faculty-card-bottom">
            {t.email ? (
              <a href={`mailto:${t.email}`} class="faculty-email-link" title={t.email}>
                <svg class="icon-mail" viewBox="0 0 24 24"><path fill="currentColor" d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
                <span>{t.email.split('@')[0]}@...</span>
              </a>
            ) : (
              <span class="faculty-no-mail">校内教师</span>
            )}
            {t.homepage_url ? (
              <a href={t.homepage_url} target="_blank" rel="noopener noreferrer" class="faculty-home-btn">
                教师主页 ›
              </a>
            ) : (
              <span class="faculty-home-btn disabled">教师主页</span>
            )}
          </div>
        </div>
      ))}
    </div>

    <!-- 3. 在读研究生 3 列网格 (结构化多行教育经历) -->
    <div id="students" class="section-head-divider">
      <div class="section-head-title">
        在读研究生
        <span class="count-pill">{students.length} 位</span>
      </div>
    </div>
    <div class="students-grid-three">
      {students.map(s => {
        const eduList = getEduList(s);
        const researchText = s.research && s.research !== '无' && s.research !== '暂无' ? s.research : '在读相关课题研究';
        return (
          <div class="student-card-modern">
            <div class="student-head-row">
              <div class="student-avatar-wrap">
                <img 
                  src={s.avatar_url || '/images/members/default_avatar.jpg'} 
                  alt={s.name}
                  onerror="this.src='/images/members/default_avatar.jpg'"
                />
              </div>
              <div class="student-identity">
                <div class="student-name-text">
                  {s.name}
                  <span class="student-grade-pill">{s.grade || s.title}</span>
                </div>
                <div class="student-status-text">
                  {s.title && s.title !== s.grade ? `${s.title} · ` : ''}{s.career || '在籍'}
                </div>
              </div>
            </div>

            <div class="student-field-row">
              <span class="field-title">研究方向：</span>
              <span class="field-val">{researchText}</span>
            </div>

            <div class="student-edu-container">
              <div class="edu-header">教育与培养经历</div>
              <div class="edu-body">
                {eduList.length > 0 ? (
                  eduList.map((item: string) => {
                    const parsed = renderEduItem(item);
                    return (
                      <div class="edu-item">
                        <span class="edu-dot">•</span>
                        <span class="edu-text">
                          {parsed.date && <span class="edu-date-range">{parsed.date}</span>}
                          {parsed.desc}
                        </span>
                      </div>
                    );
                  })
                ) : (
                  <div class="edu-placeholder">在读研究生培养中</div>
                )}
              </div>
            </div>

            <div class="student-card-footer">
              <div class="student-contact-group">
                {s.email && (
                  <a href={`mailto:${s.email}`} class="contact-pill" title={`发送邮件至 ${s.email}`}>
                    <svg class="icon-mail-gray" viewBox="0 0 24 24"><path fill="currentColor" d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
                    <span>{s.email}</span>
                  </a>
                )}
                {s.phone && (
                  <a href={`tel:${s.phone}`} class="contact-pill" title={`拨打电话 ${s.phone}`}>
                    <svg class="icon-mail-gray" viewBox="0 0 24 24"><path fill="currentColor" d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
                    <span>{s.phone}</span>
                  </a>
                )}
                {!s.email && !s.phone && (
                  <span class="contact-placeholder">在籍在读研究生</span>
                )}
              </div>
              {s.update && (
                <div class="member-update-badge" title="信息更新时间">更新于 {s.update}</div>
              )}
            </div>
          </div>
        );
      })}
    </div>

    <!-- 4. 毕业校友网格 (含照片、去向与经历) -->
    <div id="alumni" class="section-head-divider">
      <div class="section-head-title">
        毕业校友
        <span class="count-pill">{alumni.length} 位</span>
      </div>
    </div>
    <div class="alumni-grid-enhanced">
      {alumni.map(a => {
        const eduList = getEduList(a);
        const hasSpecificCareer = a.career && a.career !== '已毕业' && a.career !== '在籍';
        return (
          <div class="alumni-card-enhanced">
            <div class="alumni-card-header">
              <div class="alumni-avatar-box">
                <img 
                  src={a.avatar_url || '/images/members/default_avatar.jpg'} 
                  alt={a.name}
                  onerror="this.src='/images/members/default_avatar.jpg'"
                  loading="lazy"
                />
              </div>
              <div class="alumni-meta-info">
                <div class="alumni-name-row">
                  <span class="alumni-name-txt">{a.name}</span>
                  <span class="alumni-year-pill">{a.grade || '往届校友'}</span>
                </div>
                <div class="alumni-degree-text">{a.title || '硕士研究生'}</div>
              </div>
            </div>

            {/* 毕业去向高亮模块 */}
            <div class="alumni-career-box">
              <span class="career-icon">💼</span>
              <span class="career-text">
                {hasSpecificCareer ? a.career : (a.research && a.research.includes('目前') ? a.research : '扬州大学优秀毕业生')}
              </span>
            </div>

            {/* 教育经历（若有，按结构化渲染并防止连字符断行） */}
            {eduList.length > 0 && (
              <div class="alumni-edu-mini">
                {eduList.map((ed: string) => {
                  const parsed = renderEduItem(ed);
                  return (
                    <div class="alumni-edu-item">
                      <span class="edu-dot">•</span>
                      <span>
                        {parsed.date && <span class="edu-date-range">{parsed.date}</span>}
                        {parsed.desc}
                      </span>
                    </div>
                  );
                })}
              </div>
            )}

            {/* 底部联系方式与更新时间 */}
            {(a.email || a.phone || a.update) && (
              <div class="alumni-card-footer">
                <div class="alumni-contact-group">
                  {a.email && (
                    <a href={`mailto:${a.email}`} class="alumni-contact-item" title={a.email}>
                      <svg class="icon-mail-gray" viewBox="0 0 24 24"><path fill="currentColor" d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
                      <span>{a.email}</span>
                    </a>
                  )}
                  {a.phone && (
                    <a href={`tel:${a.phone}`} class="alumni-contact-item" title={a.phone}>
                      <svg class="icon-mail-gray" viewBox="0 0 24 24"><path fill="currentColor" d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
                      <span>{a.phone}</span>
                    </a>
                  )}
                </div>
                {a.update && (
                  <div class="member-update-badge" title="信息更新时间">更新于 {a.update}</div>
                )}
              </div>
            )}
          </div>
        );
      })}
    </div>
  </main>
</Layout>

