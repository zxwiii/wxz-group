  /* 在读研究生 3 列网格 */
  .students-grid-three {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  @media (max-width: 950px) {
    .students-grid-three { grid-template-columns: 1fr; }
  }

  .student-card-modern {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 1.4rem;
    box-shadow: 0 2px 6px rgba(0,0,0,0.03);
