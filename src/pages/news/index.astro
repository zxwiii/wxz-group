---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allNews = await getCollection('news');
// 按日期降序排列
allNews.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<Layout title="新闻动态 - 王小治课题组" activeNav="新闻动态">
  <div class="news-container">
    <div class="news-header">
      <div class="title-badge">课题组快讯</div>
      <h1 class="page-title">新闻与学术动态</h1>
      <p class="subtitle">记录课题组成长足迹、科研学术交流、重要活动与组会纪要</p>
    </div>

    <!-- 搜索与年份筛选 -->
    <div class="filter-bar">
      <div class="search-box">
        <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input type="text" id="newsSearch" placeholder="搜索新闻标题或关键词..." />
      </div>
      <div class="total-count">共 <span id="visibleCount">{allNews.length}</span> 篇动态</div>
    </div>

    <!-- 新闻列表网格 -->
    <div class="news-grid" id="newsGrid">
      {allNews.map((item) => (
        <article class="news-card" data-title={item.data.title.toLowerCase()}>
          <div class="card-body">
            <div class="card-meta">
              <span class="news-date">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                  <line x1="16" y1="2" x2="16" y2="6"></line>
                  <line x1="8" y1="2" x2="8" y2="6"></line>
                  <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
                {new Date(item.data.date).toISOString().split('T')[0]}
              </span>
              <span class="category-tag">组内简讯</span>
            </div>
            <h2 class="card-title">
              <a href={`/news/${item.slug}`}>{item.data.title}</a>
            </h2>
            <div class="card-footer">
              <a href={`/news/${item.slug}`} class="read-more">
                阅读全文
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>

  <style>
    .news-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 40px 20px 80px;
    }
    .news-header {
      text-align: center;
      margin-bottom: 40px;
    }
    .title-badge {
      display: inline-block;
      padding: 4px 14px;
      background: #e8f4fd;
      color: #185a9d;
      border-radius: 20px;
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 1px;
      margin-bottom: 12px;
    }
    .page-title {
      font-size: 32px;
      font-weight: 700;
      color: #1e293b;
      margin-bottom: 12px;
    }
    .subtitle {
      color: #64748b;
      font-size: 15px;
    }
    .filter-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 30px;
      background: #f8fafc;
      padding: 14px 20px;
      border-radius: 12px;
      border: 1px solid #e2e8f0;
    }
    .search-box {
      position: relative;
      flex: 1;
      max-width: 400px;
    }
    .search-icon {
      position: absolute;
      left: 12px;
      top: 50%;
      transform: translateY(-50%);
      width: 16px;
      height: 16px;
      stroke: #94a3b8;
    }
    .search-box input {
      width: 100%;
      padding: 8px 14px 8px 36px;
      border: 1px solid #cbd5e1;
      border-radius: 8px;
      font-size: 14px;
      outline: none;
      transition: all 0.2s;
    }
    .search-box input:focus {
      border-color: #185a9d;
      box-shadow: 0 0 0 3px rgba(24, 90, 157, 0.1);
    }
    .total-count {
      font-size: 14px;
      color: #64748b;
    }
    .total-count span {
      font-weight: 700;
      color: #185a9d;
    }
    .news-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
      gap: 24px;
    }
    .news-card {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
      transition: all 0.25s ease;
      display: flex;
      flex-direction: column;
    }
    .news-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 20px -3px rgba(0, 0, 0, 0.08);
      border-color: #cbd5e1;
    }
    .card-body {
      padding: 24px;
      display: flex;
      flex-direction: column;
      flex: 1;
    }
    .card-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 14px;
    }
    .news-date {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 13px;
      color: #64748b;
    }
    .category-tag {
      background: #f1f5f9;
      color: #475569;
      padding: 2px 10px;
      border-radius: 6px;
      font-size: 12px;
      font-weight: 500;
    }
    .card-title {
      font-size: 18px;
      font-weight: 600;
      line-height: 1.5;
      margin-bottom: 16px;
      flex: 1;
    }
    .card-title a {
      color: #1e293b;
      text-decoration: none;
      transition: color 0.2s;
    }
    .card-title a:hover {
      color: #185a9d;
    }
    .card-footer {
      border-top: 1px solid #f1f5f9;
      padding-top: 14px;
      display: flex;
      justify-content: flex-end;
    }
    .read-more {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-size: 13px;
      font-weight: 600;
      color: #185a9d;
      text-decoration: none;
      transition: gap 0.2s;
    }
    .read-more:hover {
      gap: 8px;
    }
    @media (max-width: 640px) {
      .news-grid {
        grid-template-columns: 1fr;
      }
      .filter-bar {
        flex-direction: column;
        gap: 12px;
        align-items: stretch;
      }
      .search-box {
        max-width: none;
      }
    }
  </style>

  <script>
    const searchInput = document.getElementById('newsSearch');
    const cards = document.querySelectorAll('.news-card');
    const countEl = document.getElementById('visibleCount');

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const query = (e.target.value || '').trim().toLowerCase();
        let visible = 0;
        cards.forEach((card) => {
          const title = card.getAttribute('data-title') || '';
          if (!query || title.includes(query)) {
            card.style.display = 'flex';
            visible++;
          } else {
            card.style.display = 'none';
          }
        });
        if (countEl) countEl.textContent = visible;
      });
    }
  </script>
</Layout>
