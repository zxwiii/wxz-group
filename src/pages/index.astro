<script is:inline>
  // 1. 顶部 Hero Banner 自动轮播控制
  (function initHeroSlider() {
    const slider = document.getElementById('heroSlider');
    if (!slider) return;
    const slides = slider.querySelectorAll('.hero-slide');
    const dots = slider.querySelectorAll('#heroDots .dot');
    const btnPrev = document.getElementById('heroPrev');
    const btnNext = document.getElementById('heroNext');
    let curIndex = 0;
    let timer = null;

    function goTo(idx) {
      slides[curIndex].classList.remove('active');
      dots[curIndex]?.classList.remove('active');
      curIndex = (idx + slides.length) % slides.length;
      slides[curIndex].classList.add('active');
      dots[curIndex]?.classList.add('active');
    }

    function startTimer() {
      stopTimer();
      timer = setInterval(() => goTo(curIndex + 1), 5000);
    }
    function stopTimer() {
      if (timer) clearInterval(timer);
    }

    btnPrev?.addEventListener('click', () => { goTo(curIndex - 1); startTimer(); });
    btnNext?.addEventListener('click', () => { goTo(curIndex + 1); startTimer(); });
    dots.forEach(d => {
      d.addEventListener('click', (e) => {
        const target = parseInt(e.target.dataset.target, 10);
        goTo(target);
        startTimer();
      });
    });

    slider.addEventListener('mouseenter', stopTimer);
    slider.addEventListener('mouseleave', startTimer);
    startTimer();
  })();

  // 2. 左侧科研成果突破机理图画廊轮播控制
  (function initResearchCarousel() {
    const rc = document.getElementById('researchCarousel');
    if (!rc) return;
    const slides = rc.querySelectorAll('.rc-slide');
    const btnPrev = document.getElementById('rcPrev');
    const btnNext = document.getElementById('rcNext');
    let rcIndex = 0;
    let rcTimer = null;

    function goTo(idx) {
      slides[rcIndex].classList.remove('active');
      rcIndex = (idx + slides.length) % slides.length;
      slides[rcIndex].classList.add('active');
    }

    function startTimer() {
      stopTimer();
      rcTimer = setInterval(() => goTo(rcIndex + 1), 4000);
    }
    function stopTimer() {
      if (rcTimer) clearInterval(rcTimer);
    }

    btnPrev?.addEventListener('click', (e) => { e.preventDefault(); goTo(rcIndex - 1); startTimer(); });
    btnNext?.addEventListener('click', (e) => { e.preventDefault(); goTo(rcIndex + 1); startTimer(); });

    rc.addEventListener('mouseenter', stopTimer);
    rc.addEventListener('mouseleave', startTimer);
    startTimer();
  })();
</script>
