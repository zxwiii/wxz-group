---
import Layout from '../layouts/Layout.astro';
import newsData from '../data/news.json';

// 获取最新 5 篇通知公告
const recentNews = newsData.slice(0, 5);

// 顶部 Hero 横幅轮播列表
const heroBanners = [
  { src: '/images/hengfu/wxz横幅.jpg', alt: '王小治课题组欢迎您的加入 - 扬州大学' },
  { src: '/images/hengfu/横幅2.png', alt: '先进环境功能材料与水土生态修复创新研究' },
  { src: '/images/hengfu/横幅4.png', alt: '全球气候变化与土壤生物地球化学循环学术前沿' }
];

// 左侧科研前沿突破机理图轮播列表 (用户指定圈选的 4 张精选成果图)
const researchHighlights = [
  {
    img: '/images/49_ABUIABACGAAgkoy5twYo0IiF_gYwuAg40gU.jpg',
    title: '王小治教授、朱兴旺副教授、博士生周港华的研究论文在 Appl. Catal. B-Environ. 发表',
    link: '/publications'
  },
  {
    img: '/images/16_ABUIABACGAAg7pey1gYogLfshgEw3ww49gY.jpg',
    title: '单原子功能催化位点构建与水土微污染物界面活化降解机制',
    link: '/research'
  },
  {
    img: '/images/40_ABUIABACGAAg_dzPsgYojNXBhgQwzgk4ngY.jpg',
    title: '新型纳米复合光催化体系构建及光驱动 CO₂ 高效转化与重整',
    link: '/research'
  },
  {
    img: '/images/73_ABUIABACGAAgiJqy1gYo9oS83gEwpww49gY.jpg',
    title: '界面电荷高效传输与光电催化微污染深度氧化机理研究',
    link: '/publications'
  }
];
---

<Layout title="主页" activeNav="首页">
  <!-- 1. 顶部 Hero Banner 多图平滑轮播 (支持自动+箭头+圆点切换) -->
  <section class="home-hero-slider-wrap" id="heroSlider">
    <div class="slider-viewport">
      {heroBanners.map((b, idx) => (
        <div class={`hero-slide ${idx === 0 ? 'active' : ''}`} data-index={idx}>
          <img src={b.src} alt={b.alt} class="hero-banner-img" loading={idx === 0 ? 'eager' : 'lazy'} />
        </div>
      ))}
    </div>

    <!-- 左右悬浮切换按钮 -->
    <button class="slider-arrow prev" id="heroPrev" aria-label="上一张横幅">‹</button>
    <button class="slider-arrow next" id="heroNext" aria-label="下一张横幅">›</button>

    <!-- 底部圆点指示器 -->
    <div class="slider-dots" id="heroDots">
      {heroBanners.map((_, idx) => (
        <span class={`dot ${idx === 0 ? 'active' : ''}`} data-target={idx}></span>
      ))}
    </div>
  </section>

  <!-- 2. 横幅下方：左侧科研突破图片轮播 + 右侧通知公告 (完全还原实拍版式) -->
  <section class="home-bulletin-section">
    <div class="bulletin-container">
      
      <!-- 左栏：前沿科研机理图画廊轮播 (对标图2) -->
      <div class="bulletin-left-card">
        <div class="sub-header-bar">
          <span class="sub-bar-tag">前沿科研突破</span>
          <a href="/research" class="sub-bar-link">more &gt;&gt;</a>
        </div>

        <div class="research-carousel" id="researchCarousel">
          <div class="rc-viewport">
            {researchHighlights.map((item, idx) => (
              <a href={item.link} class={`rc-slide ${idx === 0 ? 'active' : ''}`} data-rc-index={idx}>
                <img src={item.img} alt={item.title} class="rc-img" />
                <div class="rc-caption-bar">
                  <span class="rc-caption-text">{item.title}</span>
                  <div class="rc-indicators">
                    {researchHighlights.map((_, dotIdx) => (
                      <span class={`rc-dot ${dotIdx === idx ? 'active' : ''}`}></span>
                    ))}
                  </div>
                </div>
              </a>
            ))}
          </div>

          <!-- 左右控制按钮 -->
          <button class="rc-btn prev" id="rcPrev" aria-label="上一个科研成果">‹</button>
          <button class="rc-btn next" id="rcNext" aria-label="下一个科研成果">›</button>
        </div>
      </div>

      <!-- 右栏：通知公告与团队动态 -->
      <div class="bulletin-right-card">
        <div class="sub-header-bar">
          <span class="sub-bar-tag news">通知公告</span>
          <a href="/news" class="sub-bar-link">more &gt;&gt;</a>
        </div>

        <ul class="bulletin-news-list">
          {recentNews.map(item => (
            <li class="b-news-item">
              <span class="b-news-dot">•</span>
              <a href={`/news/${item.slug}`} class="b-news-title" title={item.title}>
                {item.title}
              </a>
              <span class="b-news-date">{item.date}</span>
            </li>
          ))}
        </ul>

        <div class="bulletin-quick-actions">
          <a href="/joinus" class="b-btn recruit">诚邀博士后与研究生 ›</a>
          <a href="/publications" class="b-btn papers">浏览代表作 ›</a>
        </div>
      </div>

    </div>
  </section>

  <!-- 3. 王小治教授个人名片卡片 (深海蓝玻璃拟态) -->
  <div class="home-hero-container" style="background: linear-gradient(135deg, #0f2c59 0%, #1e3a8a 100%); padding: 2.5rem 1rem 3.5rem;">
    <div class="jz_fix_ue_img">
      <style is:global>
        .profile-card-container {
          max-width: 1200px;
          margin: 20px auto;
          padding: 25px;
          background: rgba(255, 255, 255, 0.12);
          backdrop-filter: blur(10px);
          -webkit-backdrop-filter: blur(10px);
          border: 1px solid rgba(255, 255, 255, 0.25);
          border-radius: 16px;
          box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.15);
          font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
          color: #ffffff;
          line-height: 1.6;
        }

        .profile-layout {
          display: flex;
          gap: 30px;
          align-items: flex-start;
        }

        .profile-avatar-box {
          flex: 0 0 260px;
          text-align: center;
        }

        .profile-avatar-box img {
          width: 100%;
          max-width: 260px;
          height: auto;
          border-radius: 12px;
          box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
          object-fit: cover;
          border: 2px solid rgba(255, 255, 255, 0.3);
        }

        .profile-info {
          flex: 1;
        }

        .profile-header {
          border-bottom: 1px solid rgba(255, 255, 255, 0.2);
          padding-bottom: 12px;
          margin-bottom: 18px;
        }

        .profile-name {
          margin: 0 0 6px 0;
          font-size: 28px;
          font-weight: 700;
          color: #ffffff;
          letter-spacing: 0.5px;
        }

        .profile-titles {
          font-size: 15px;
          color: rgba(255, 255, 255, 0.9);
          font-weight: 500;
        }

        .profile-titles span {
          display: inline-block;
          margin-right: 15px;
        }

        .profile-section {
          margin-bottom: 18px;
        }

        .section-title {
          font-size: 16px;
          font-weight: 600;
          color: #38bdf8;
          margin-bottom: 6px;
          display: flex;
          align-items: center;
        }

        .section-title::before {
          content: "";
          display: inline-block;
          width: 4px;
          height: 15px;
          background-color: #38bdf8;
          margin-right: 8px;
          border-radius: 2px;
        }

        .profile-text {
          font-size: 14px;
          color: rgba(255, 255, 255, 0.88);
          text-align: justify;
          margin: 0;
        }

        .stats-grid {
          display: grid;
          grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
          gap: 10px;
          margin-top: 12px;
          margin-bottom: 18px;
        }

        .stat-item {
          background: rgba(255, 255, 255, 0.1);
          border: 1px solid rgba(255, 255, 255, 0.15);
          border-radius: 8px;
          padding: 8px;
          text-align: center;
        }

        .stat-value {
          font-size: 20px;
          font-weight: 700;
          color: #60a5fa;
        }

        .stat-label {
          font-size: 12px;
          color: rgba(255, 255, 255, 0.75);
          margin-top: 2px;
        }

        .journal-tags {
          display: flex;
          flex-wrap: wrap;
          gap: 6px;
          margin-top: 6px;
        }

        .journal-tag {
          background: rgba(56, 189, 248, 0.15);
          color: #7dd3fc;
          border: 1px solid rgba(56, 189, 248, 0.3);
          font-size: 12px;
          padding: 2px 8px;
          border-radius: 4px;
          font-weight: 500;
        }

        @media (max-width: 768px) {
          .profile-layout {
            flex-direction: column;
            align-items: center;
          }
          .profile-avatar-box {
            width: 100%;
          }
        }
      </style>

      <div class="profile-card-container">
        <div class="profile-layout">
          <div class="profile-avatar-box">
            <img src="/images/46_ABUIABBfGAAgo-nJ1QYor6_5iAEw4AQ4uAg.webp" alt="王小治教授照片" />
          </div>
          <div class="profile-info">
            <div class="profile-header">
              <h2 class="profile-name">王小治&nbsp;教授</h2>
              <div class="profile-titles">
                <span>扬州大学环境科学与工程一级学科带头人</span> &nbsp;<span>扬州大学环境科学与工程学院院长</span>
              </div>
            </div>
            <div class="stats-grid">
              <div class="stat-item">
                <div class="stat-value">200+</div>
                <div class="stat-label">高水平论文</div>
              </div>
              <div class="stat-item">
                <div class="stat-value">7000+</div>
                <div class="stat-label">论文引用</div>
              </div>
              <div class="stat-item">
                <div class="stat-value">40+</div>
                <div class="stat-label">h-Index</div>
              </div>
              <div class="stat-item">
                <div class="stat-value">50+</div>
                <div class="stat-label">国家专利</div>
              </div>
            </div>
            <div class="profile-section">
              <div class="section-title">履历与学术兼职</div>
              <p class="profile-text">
                毕业于中科院南京土壤研究所，德国吉森大学访问学者。曾主持数十项国家级和省部级项目；获江苏省科技进步三等奖1项，江苏省教学成果二等奖2次。兼任中国土壤学会理事、江苏省环境科学学会理事，获评江苏省“六大人才高峰”节能环保创新团队负责人、江苏省333工程培养对象、江苏省“青蓝工程”中青年学术带头人，并被聘为国家科技部重点专项会评专家。现任《农业资源与环境学报》编委，以及&nbsp;JACS、EST、WR、Adv.&nbsp;Mater.&nbsp;等顶级期刊特邀审稿人。
              </p>
            </div>
            <div class="profile-section">
              <div class="section-title">研究兴趣</div>
              <p class="profile-text">
                主要从事<strong>全球气候变化与土壤生物地球化学循环</strong>、<strong>固体废弃物处置及资源化</strong>、<strong>环境材料制备及水土环境应用</strong>等方向的研究。
              </p>
            </div>
            <div class="profile-section" style="margin-bottom:0;">
              <div class="section-title">主要发表期刊</div>
              <div class="journal-tags">
                <span class="journal-tag">Environ.&nbsp;Sci.&nbsp;Technol.</span> &nbsp;<span class="journal-tag">Angew.&nbsp;Chemie.</span> &nbsp;<span class="journal-tag">Water&nbsp;Res.</span> &nbsp;<span class="journal-tag">Adv.&nbsp;Sci.</span> &nbsp;<span class="journal-tag">ACS&nbsp;Catal.</span> &nbsp;<span class="journal-tag">ACS&nbsp;Nano</span> &nbsp;<span class="journal-tag">Appl.&nbsp;Catal.&nbsp;B</span> &nbsp;<span class="journal-tag">J.&nbsp;Hazard.&nbsp;Mater.</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 4. 4大核心研究方向专栏 -->
  <style is:global>
    .awsr-research-wrapper {
      max-width: 1240px;
      margin: 40px auto 20px;
      padding: 10px 15px;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      box-sizing: border-box;
    }

    .awsr-sec-header {
      text-align: center;
      margin-bottom: 30px;
    }

    .awsr-sec-title {
      font-size: 26px;
      font-weight: 800;
      color: #0f2b48;
      margin: 0;
      letter-spacing: 1px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
    }

    .awsr-sec-title::before,
    .awsr-sec-title::after {
      content: "";
      width: 35px;
      height: 3px;
      background: linear-gradient(90deg, #0284c7, transparent);
      border-radius: 2px;
    }
    .awsr-sec-title::before {
      background: linear-gradient(270deg, #0284c7, transparent);
    }

    .awsr-sec-subtitle {
      font-size: 13px;
      color: #0284c7;
      font-weight: 600;
      letter-spacing: 2px;
      text-transform: uppercase;
      margin-top: 6px;
    }

    .awsr-cards-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
    }

    .awsr-single-card {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 14px;
      padding: 24px 20px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      box-shadow: 0 4px 20px rgba(15, 23, 42, 0.06);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      overflow: hidden;
    }

    .awsr-single-card::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: linear-gradient(90deg, #0284c7, #38bdf8);
      opacity: 0.85;
      transition: all 0.3s ease;
    }

    .awsr-single-card:hover {
      transform: translateY(-6px);
      border-color: #38bdf8;
      box-shadow: 0 16px 32px rgba(2, 132, 199, 0.15);
    }

    .awsr-single-card:hover::before {
      height: 6px;
    }

    .awsr-card-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 16px;
    }

    .awsr-icon-badge {
      width: 48px;
      height: 48px;
      border-radius: 12px;
      background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 6px 14px rgba(2, 132, 199, 0.3);
      color: #ffffff;
    }

    .awsr-icon-badge svg {
      width: 24px;
      height: 24px;
      fill: currentColor;
    }

    .awsr-index-num {
      font-size: 24px;
      font-weight: 800;
      color: #cbd5e1;
      font-family: Impact, "Arial Black", sans-serif;
    }

    .awsr-item-title {
      font-size: 17px;
      font-weight: 700;
      color: #0f172a;
      margin: 0 0 5px 0;
      line-height: 1.4;
    }

    .awsr-item-en {
      font-size: 12px;
      color: #0284c7;
      font-weight: 600;
      margin-bottom: 12px;
    }

    .awsr-item-desc {
      font-size: 13px;
      line-height: 1.65;
      color: #475569;
      margin: 0 0 16px 0;
      text-align: justify;
      flex-grow: 1;
    }

    .awsr-tags-bar {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-top: auto;
      padding-top: 12px;
      border-top: 1px dashed #e2e8f0;
    }

    .awsr-tag-pill {
      font-size: 11px;
      padding: 3px 8px;
      border-radius: 6px;
      background: #f0f9ff;
      color: #0369a1;
      border: 1px solid #bae6fd;
      font-weight: 500;
    }

    @media (max-width: 992px) {
      .awsr-cards-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 576px) {
      .awsr-cards-grid {
        grid-template-columns: 1fr;
      }
      .awsr-sec-title {
        font-size: 22px;
      }
    }
  </style>

  <div class="awsr-research-wrapper">
    <div class="awsr-sec-header">
      <h2 class="awsr-sec-title">核心研究方向</h2>
      <div class="awsr-sec-subtitle">Research Fields & Innovation</div>
    </div>

    <div class="awsr-cards-grid">
      <!-- 卡片 1 -->
      <div class="awsr-single-card">
        <div>
          <div class="awsr-card-head">
            <div class="awsr-icon-badge">
              <svg viewBox="0 0 24 24"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>
            </div>
            <span class="awsr-index-num">01</span>
          </div>
          <h3 class="awsr-item-title">水土环境修复与污染控制</h3>
          <div class="awsr-item-en">Soil & Water Remediation</div>
          <p class="awsr-item-desc">
            聚焦农田土壤重金属污染钝化与原位生态修复，研发新型高效阻控材料，系统治理农业面源污染，保障农产品质量与水生态安全。
          </p>
        </div>
        <div class="awsr-tags-bar">
          <span class="awsr-tag-pill">重金属钝化</span>
          <span class="awsr-tag-pill">原位修复</span>
          <span class="awsr-tag-pill">面源污染防控</span>
        </div>
      </div>

      <!-- 卡片 2 -->
      <div class="awsr-single-card">
        <div>
          <div class="awsr-card-head">
            <div class="awsr-icon-badge">
              <svg viewBox="0 0 24 24"><path d="M12 11a1 1 0 1 0 0 2 1 1 0 0 0 0-2zm0-9C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/></svg>
            </div>
            <span class="awsr-index-num">02</span>
          </div>
          <h3 class="awsr-item-title">先进催化与环境功能材料</h3>
          <div class="awsr-item-en">Catalysis & Advanced Materials</div>
          <p class="awsr-item-desc">
            开展单原子催化剂精准构建及其在微污染物深度降解中的机制研究；开发高效半导体光催化体系，实现光驱动 CO₂ 转化与能源重整。
          </p>
        </div>
        <div class="awsr-tags-bar">
          <span class="awsr-tag-pill">单原子催化</span>
          <span class="awsr-tag-pill">光催化还原CO₂</span>
          <span class="awsr-tag-pill">高活性位点</span>
        </div>
      </div>

      <!-- 卡片 3 -->
      <div class="awsr-single-card">
        <div>
          <div class="awsr-card-head">
            <div class="awsr-icon-badge">
              <svg viewBox="0 0 24 24"><path d="M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46A7.93 7.93 0 0 0 20 12c0-4.42-3.58-8-8-8zm0 14c-3.31 0-6-2.69-6-6 0-1.01.25-1.97.7-2.8L5.24 7.74A7.93 7.93 0 0 0 4 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3z"/></svg>
            </div>
            <span class="awsr-index-num">03</span>
          </div>
          <h3 class="awsr-item-title">土壤碳氮循环与全球变化</h3>
          <div class="awsr-item-en">Carbon & Nitrogen Cycling</div>
          <p class="awsr-item-desc">
            揭示全球气候变化背景下农田土壤碳氮生物地球化学循环过程，探明温室气体产生与减排机制，解析土壤碳固存及其微生物驱动机制。
          </p>
        </div>
        <div class="awsr-tags-bar">
          <span class="awsr-tag-pill">温室气体减排</span>
          <span class="awsr-tag-pill">土壤碳固存</span>
          <span class="awsr-tag-pill">微生物群落</span>
        </div>
      </div>

      <!-- 卡片 4 -->
      <div class="awsr-single-card">
        <div>
          <div class="awsr-card-head">
            <div class="awsr-icon-badge">
              <svg viewBox="0 0 24 24"><path d="M4 10v7h3v-7H4zm6 0v7h3v-7h-3zm6 0v7h3v-7h-3zM2 22h19v-3H2v3zm1-15l8-5 8 5v2H3V7z"/></svg>
            </div>
            <span class="awsr-index-num">04</span>
          </div>
          <h3 class="awsr-item-title">农业废弃物处置与资源化</h3>
