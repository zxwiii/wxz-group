---
import Layout from '../layouts/Layout.astro';
---

<Layout title="诚邀英才" activeNav="joinus">
  <!-- 用户原版诚邀英才.txt (无损嵌入) -->
  <div class="jz_fix_ue_img">
    <div style="text-align:center;padding:40px 0 30px;">
        <div style="display:inline-flex;align-items:center;gap:12px;margin-bottom:14px;">
            <span style="display:block;width:40px;height:2px;background:linear-gradient(to right, transparent, #0e8faa);"></span><span style="font-size:0.85rem;color:#0e8faa;letter-spacing:4px;font-weight:500;">JOIN&nbsp;US</span><span style="display:block;width:40px;height:2px;background:linear-gradient(to left, transparent, #0e8faa);"></span>
 &nbsp;
        </div>
        <h2 style="font-size:2.2rem;font-weight:700;color:#0f172a;margin:0;letter-spacing:6px;line-height:1;">
            诚邀英才
        </h2>
        <div style="margin:16px auto 0;width:50px;height:4px;border-radius:2px;background:linear-gradient(to right, #0e8faa, #22d3ee);">
        </div>
    </div>
    <div style="max-width:860px;margin:0 auto;padding:0 20px 60px;font-family:&#39;Helvetica Neue&#39;, Helvetica, Arial, sans-serif;color:#0f172a;line-height:1.9;">
        <p style="font-size:1.05rem;color:#334155;text-align:center;margin-bottom:36px;">
            王小治课题组长期欢迎充满热情、积极进取的研究人员加入，我们提供开放、包容、充满活力的科研环境，共同探索前沿科学问题。
        </p>
        <div style="background:#f8fafc;border-left:4px solid #0e8faa;border-radius:0 8px 8px 0;padding:20px 24px;margin-bottom:24px;">
            <h3 style="font-size:1.1rem;font-weight:600;color:#0e8faa;margin:0 0 12px;">
                招募对象
            </h3>
            <ul style="margin:0;color:#334155;font-size:0.97rem;padding-left:1.2rem;">
                <li style="margin-bottom:6px;">
                    具有较强科研意愿的&nbsp;<strong>硕士研究生、博士研究生</strong>
                </li>
                <li style="margin-bottom:6px;">
                    寻求科研合作或学术交流的&nbsp;<strong>博士后研究人员</strong>
                </li>
                <li>
                    希望参与课题组科研项目的&nbsp;<strong>访问学者</strong>
                </li>
            </ul>
        </div>
        <div style="background:#f8fafc;border-left:4px solid #0e8faa;border-radius:0 8px 8px 0;padding:20px 24px;margin-bottom:24px;">
            <h3 style="font-size:1.1rem;font-weight:600;color:#0e8faa;margin:0 0 12px;">
                专业背景
            </h3>
            <p style="margin:0;color:#334155;font-size:0.97rem;">
                欢迎来自以下领域的候选人，但不限于：
            </p>
            <div style="display:flex;flex-wrap:wrap;gap:10px;margin-top:12px;">
                <span style="background:#e0f7fa;color:#0e8faa;padding:4px 14px;border-radius:20px;font-size:0.88rem;">土壤学</span> &nbsp;<span style="background:#e0f7fa;color:#0e8faa;padding:4px 14px;border-radius:20px;font-size:0.88rem;">环境科学</span> &nbsp;<span style="background:#e0f7fa;color:#0e8faa;padding:4px 14px;border-radius:20px;font-size:0.88rem;">化学</span> &nbsp;<span style="background:#e0f7fa;color:#0e8faa;padding:4px 14px;border-radius:20px;font-size:0.88rem;">材料科学</span> &nbsp;<span style="background:#e0f7fa;color:#0e8faa;padding:4px 14px;border-radius:20px;font-size:0.88rem;">计算科学</span> &nbsp;<span style="background:#e0f7fa;color:#0e8faa;padding:4px 14px;border-radius:20px;font-size:0.88rem;">生态学</span> &nbsp;<span style="background:#e0f7fa;color:#0e8faa;padding:4px 14px;border-radius:20px;font-size:0.88rem;">地球化学</span>
            </div>
        </div>
        <div style="background:#f8fafc;border-left:4px solid #0e8faa;border-radius:0 8px 8px 0;padding:20px 24px;margin-bottom:24px;">
            <h3 style="font-size:1.1rem;font-weight:600;color:#0e8faa;margin:0 0 12px;">
                ✨&nbsp;我们提供
            </h3>
            <ul style="margin:0;color:#334155;font-size:0.97rem;padding-left:1.2rem;">
                <li style="margin-bottom:6px;">
                    开放包容、积极向上的团队科研氛围
                </li>
                <li style="margin-bottom:6px;">
                    充足的科研经费支持与实验条件保障
                </li>
                <li style="margin-bottom:6px;">
                    与国内外顶尖科研机构的合作交流机会
                </li>
                <li>
                    导师的悉心指导与个人职业发展规划支持
                </li>
            </ul>
        </div>
        <p style="font-size:0.9rem;color:#64748b;text-align:center;font-style:italic;margin-bottom:36px;">
            ⚠️&nbsp;本页将根据课题组科研资助的可用性及招募情况持续更新，请定期关注。
        </p>
        <div style="background:linear-gradient(135deg, #0e8faa11, #22d3ee11);border:1px solid #0e8faa44;border-radius:12px;padding:28px 32px;text-align:center;">
            <h3 style="font-size:1.15rem;font-weight:600;color:#0f172a;margin:0 0 16px;letter-spacing:2px;">
                联系方式
            </h3>
            <p style="margin:0 0 6px;font-size:1rem;font-weight:600;color:#0f172a;">
                王小治&nbsp;教授（课题组&nbsp;PI）
            </p>
            <p style="margin:0 0 6px;font-size:0.95rem;color:#334155;">
                扬州大学环境科学与工程学院
            </p>
            <p style="margin:0;font-size:0.95rem;color:#334155;">
                Email：<a href="mailto:xzwang@yzu.edu.cn" style="color:#0e8faa !important;text-decoration:none !important;font-weight:500;">xzwang@yzu.edu.cn</a>
            </p>
        </div>
    </div>
</div>
</Layout>
