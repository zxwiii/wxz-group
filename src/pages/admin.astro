                  <td style="text-align: right; padding-right: 20px; white-space: nowrap;">
                    <button type="button" class="btn-action-edit" data-slug={item.slug}>✏️ 修改</button>
                    <a href={item.data.accessLevel === 'internal' ? `/internal/news/${item.slug}` : `/news/${item.slug}`} target="_blank" class="btn-action-view">查看</a>
                    <button type="button" class="btn-action-delete" data-slug={item.slug} data-title={item.data.title}>🗑️ 删除</button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
