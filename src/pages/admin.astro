                  <option value="internal">🔒 仅组内可见 (归入 /internal 路由，由 Microsoft 365 / Zero Trust 物理拦截)</option>
                </select>
              </div>
            </div>

            <!-- 可视化富文本编辑器容器 (wangEditor) -->
            <div class="editor-wrapper">
              <div class="editor-tips-bar">
                <span>📝 <strong>纯中文可视化排版模式</strong>：直接在下方打字、加粗、排版表格；点击工具栏“图片”图标即可一键插入电脑本地图片</span>
                <button type="button" id="btnToggleHtmlSource" class="btn-source-toggle">查看 / 编辑 HTML 源代码</button>
              </div>

              <!-- wangEditor 工具栏挂载点 -->
              <div id="editor-toolbar-container" class="editor-toolbar-box"></div>

