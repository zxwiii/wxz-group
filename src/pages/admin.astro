                  <option value="组会安排">组会安排 (周报日程、汇报纪要)</option>
                  <option value="学术交流">学术交流 (学术会议、专家来访)</option>
                  <option value="通知公告">通知公告 (招聘、招生、制度)</option>
                  <option value="课题组快讯">课题组快讯 (其他综合动态)</option>
                </select>
              </div>

              <div class="field-item">
                <label>阅读权限控制 (支持微软单点登录) *</label>
                <select id="postAccess" class="form-input">
