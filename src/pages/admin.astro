      <!-- 3. 动态管理列表（修改、删除、搜索） -->
      <section id="tab-news" class="tab-pane">
        <div class="section-title-bar">
          <h2>📰 科研动态与组会管理 ({allNews.length})</h2>
          <input type="text" id="filterInput" class="form-input" style="width: 260px;" placeholder="检索文章标题关键词..." />
        </div>

        <div class="panel-card" style="padding: 0; overflow: hidden;">
          <table class="data-table">
            <thead>
              <tr>
                <th>发布日期</th>
                <th>文章标题</th>
                <th>所属分类</th>
                <th>阅读权限</th>
                <th style="text-align: right; padding-right: 24px;">操作管理</th>
              </tr>
            </thead>
            <tbody id="articleTableBody">
              {allNews.map(item => (
                <tr data-title={(item.data.title || '').toLowerCase()} data-slug={item.slug}>
                  <td style="color: #64748b; font-size: 13px; white-space: nowrap;">
                    {formatSafeDate(item.data.date)}
                  </td>
                  <td style="font-weight: 600; color: #1e293b;">
                    <a href={item.data.accessLevel === 'internal' ? `/internal/news/${item.slug}` : `/news/${item.slug}`} target="_blank" style="color: #1e293b; text-decoration: none;">
                      {item.data.title}
