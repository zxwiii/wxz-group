---
import Layout from '../layouts/Layout.astro';

// 四大核心研究方向与顶刊代表作数据
const researchDirections = [
  {
    num: "01",
    titleCn: "水土环境修复与污染控制",
    titleEn: "Soil & Water Remediation & Environmental Quality",
    summary: "针对长江中下游及典型农业区农田土壤重金属（Cd、Pb、Hg、As）复合污染与农业面源污染问题，重点研发改性层状双金属氢氧化物（LDH）、铁基纳米功能矿物及绿色钝化修复剂，系统揭示重金属在“土壤-作物-水体”系统的生物有效性迁移阻控机制，构建农田原位生态安全修复技术体系。",
    papers: [
      {
        title: "Passivation Remediation of Cd-Contaminated Farmland by CaAl-LDH: A Mechanism and Application Study",
        authorsHtml: "Lu, X.; Wei, N.; Fang, H.; ... <b>Wang, Xiaozhi*</b>.",
        journal: "Agronomy",
        year: "2025",
        vol: "15",
        page: "2354",
        doi: "https://doi.org/10.3390/agronomy15102354"
      },
      {
        title: "Enhanced removal of lead complexes using phosphide-modified nanoscale zero-valent iron: The boosting impact of the iron cycle",
        authorsHtml: "Li, Rui; Liu, Xinya; Ge, Xiao; <b>Wang, Xiaozhi*</b>.",
        journal: "Journal of Cleaner Production",
        year: "2025",
        vol: "501",
        page: "145336",
        doi: "https://doi.org/10.1016/j.jclepro.2025.145336"
      },
      {
        title: "Efficient Hg(II) removed by L-cysteine modified UiO-66 through chemical adsorption via a facile partial ligand replacement strategy",
        authorsHtml: "Dai, Zeming; Zhou, Xuan; Lin, Yuting; ... <b>Wang, Xiaozhi*</b>.",
        journal: "Journal of Colloid and Interface Science",
        year: "2025",
        vol: "684",
        page: "705-716",
        doi: "https://doi.org/10.1016/j.jcis.2025.01.043"
      }
    ]
  },
  {
    num: "02",
    titleCn: "先进催化与环境功能材料",
    titleEn: "Advanced Catalysis & Functional Environmental Materials",
    summary: "立足前沿催化化学与低碳能源转化，重点开展单原子催化剂（SACs）的活性位点微环境精准调控、缺陷工程石墨相氮化碳（g-C₃N₄）及金属有机骨架（MOF/COF）衍生复合材料设计；应用于类芬顿高级氧化微污染物深度降解、高效光催化还原 CO₂ 转化合成燃料及光催化固氮固碳。",
    papers: [
      {
        title: "Electronic Structure Reconfiguration of Zn-NxB4-x Sites for Enhanced Fenton-Like Catalysis",
        authorsHtml: "Ge, Xiao; Xu, Jinze; Zhou, Tao; ... <b>Wang, Xiaozhi*</b>.",
        journal: "Angewandte Chemie International Edition",
        year: "2025",
        vol: "64",
        page: "e202515736",
        doi: "https://doi.org/10.1002/anie.202515736"
      },
      {
        title: "Engineering Spin State of Atomic Iron Centers for High-Performance Photocatalytic Nitrogen Fixation",
        authorsHtml: "Ge, Xiao; Zheng, Xiyang; Zhou, Tao; ... <b>Wang, Xiaozhi*</b>.",
        journal: "Angewandte Chemie International Edition",
        year: "2025",
        vol: "64",
        page: "e202506470",
        doi: "https://doi.org/10.1002/anie.202506470"
      },
      {
        title: "Enhanced CO2 photoreduction in pure water systems by surface-reconstructed asymmetric Mn-Cu sites",
        authorsHtml: "Zhou, Ganghua; Chen, Yun; Xu, Hangmin; ... <b>Wang, Xiaozhi*</b>.",
        journal: "Applied Catalysis B: Environment and Energy",
        year: "2025",
        vol: "361",
        page: "124617",
        doi: "https://doi.org/10.1016/j.apcatb.2024.124617"
      }
    ]
  },
  {
    num: "03",
    titleCn: "土壤碳氮循环与全球变化",
    titleEn: "Soil Carbon & Nitrogen Cycling & Climate Change",
    summary: "深入探究全球气候变化（大气 CO₂ 浓度升高、增温及极端降雨）对典型农业土壤生物地球化学循环的驱动机理。定量评估稻麦轮作、果园草-豆间作模式下土壤温室气体（CO₂、CH₄、N₂O）产生与减排潜能，阐释矿物结合态有机碳与微生物残体碳的动态转化及土壤长效碳汇稳定性。",
    papers: [
      {
        title: "Grass-legume mixture optimizes soil new carbon sequestration by leveraging microbial necromass dynamics in a pear orchard",
        authorsHtml: "Xu, Qiao; Zhao, Yingdong; Xu, Meiling; ... <b>Wang, Xiaozhi*</b>.",
        journal: "Agriculture, Ecosystems & Environment",
        year: "2025",
        vol: "394",
        page: "109898",
        doi: "https://doi.org/10.1016/j.agee.2025.109898"
      },
      {
        title: "Coupled iron oxides and microbial-mediated soil organic carbon stabilization across tea plantation chronosequences",
        authorsHtml: "Tang, Quan; Li, Wei; Wang, Jing; ... <b>Wang, Xiaozhi*</b>.",
        journal: "Soil & Tillage Research",
        year: "2025",
        vol: "247",
        page: "106382",
        doi: "https://doi.org/10.1016/j.still.2024.106382"
      },
      {
        title: "Biochar mitigated zerovalent iron-induced methane emissions in arsenic-contaminated paddy soil",
        authorsHtml: "Ding, Chengyu; Wei, Liqing; ... <b>Wang, Xiaozhi*</b>; Wang, Shengsen.",
        journal: "Chemical Engineering Journal",
        year: "2025",
        vol: "522",
        page: "168110",
        doi: "https://doi.org/10.1016/j.cej.2025.168110"
      }
    ]
  },
  {
    num: "04",
    titleCn: "农业废弃物处置与资源化",
    titleEn: "Agricultural Waste Recycling & Biochar Engineering",
    summary: "针对农林秸秆、海带残渣、养殖废弃物及市政污泥等大宗固体废弃物，研发定向热解、微波辅助炭化及化学改性技术，创制多孔生物炭基土壤调理剂与微纳碳点材料；探索废弃生物质高值化在重金属原位固化、抗生素抗性基因阻控及绿色水土功能材料方面的全链条循环利用路径。",
    papers: [
      {
        title: "Transforming Waste Biomass into N-Rich Carbon Dots with Built-In Active Sites for Efficient CO2 Photoreduction from Flue Gas",
        authorsHtml: "Zhou, Ganghua; Bi, Chuanzhou; ... <b>Wang, Xiaozhi*</b>; Zhu, Xingwang.",
        journal: "ACS Catalysis",
        year: "2025",
        vol: "15",
        page: "15972-15981",
        doi: "https://doi.org/10.1021/acscatal.5c04589"
      },
      {
        title: "Highly dispersed kelp-derived carbon dots for peroxydisulfate activation towards efficient degradation of tetracycline",
        authorsHtml: "Ning, Xin; Chen, Gaoran; Wang, Heming; ... <b>Wang, Xiaozhi*</b>.",
        journal: "Colloids and Surfaces A",
        year: "2025",
        vol: "727",
        page: "138149",
        doi: "https://doi.org/10.1016/j.colsurfa.2025.138149"
      },
      {
        title: "Divergent mitigation mechanisms of soil antibiotic resistance genes by biochar from different agricultural wastes",
        authorsHtml: "Yao, Yu; Yang, Peiyang; Wang, Bin; ... <b>Wang, Xiaozhi*</b>.",
        journal: "Environmental Pollution",
        year: "2025",
        vol: "374",
        page: "126247",
        doi: "https://doi.org/10.1016/j.envpol.2025.126247"
      }
    ]
  }
];
---

<Layout title="研究方向 - 王小治课题组" activeNav="research">
  <!-- 全站统一标准深蓝大气横幅 -->
  <div class="page-title-banner">
    <h1 class="page-title-cn">研究方向</h1>
    <p class="page-subtitle-cn">聚焦水土环境修复、先进催化材料、碳氮循环与农业资源化前沿</p>
  </div>

  <main class="research-page-container">
    <div class="research-cards-stack">
      {researchDirections.map(dir => (
        <article class="dir-card-modern">
          <!-- 头部：序号徽章 + 中英文标题 -->
          <header class="dir-card-header">
            <div class="dir-num-badge">{dir.num}</div>
            <div class="dir-title-box">
              <h2 class="dir-title-cn">{dir.titleCn}</h2>
              <div class="dir-title-en">{dir.titleEn}</div>
            </div>
          </header>

          <!-- 方向研究概述 -->
          <div class="dir-summary-box">
            <p class="dir-summary-text">{dir.summary}</p>
          </div>

          <!-- 代表性成果论文区 -->
          <section class="dir-pubs-section">
            <div class="dir-pubs-label">
              <span class="pubs-dot"></span>
              <span>代表性成果与顶刊突破：</span>
            </div>

            <div class="dir-pubs-list">
              {dir.papers.map(p => (
                <div class="pub-item-card">
                  <h3 class="pub-paper-title">{p.title}</h3>
                  <div class="pub-paper-meta">
                    <span class="pub-authors" set:html={p.authorsHtml}></span>
                    <span class="pub-journal">
                      <em>{p.journal}</em>, {p.year}, {p.vol}, {p.page}.
                    </span>
                  </div>
                  <div class="pub-doi-wrap">
                    <a href={p.doi} target="_blank" rel="noopener noreferrer" class="pub-doi-link">
                      <span>DOI: {p.doi.replace('https://doi.org/', '')}</span>
                      <svg class="icon-external" viewBox="0 0 24 24" width="13" height="13">
                        <path fill="currentColor" d="M14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3m-2 16H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7z"/>
                      </svg>
                    </a>
                  </div>
                </div>
              ))}
            </div>
          </section>
        </article>
      ))}
    </div>
  </main>
</Layout>

<style>
  /* 页面标题横幅 (全站统一风格) */
  .page-title-banner {
    background: linear-gradient(135deg, #0f2c59 0%, #1e3a8a 100%);
    color: #ffffff;
    padding: 3.5rem 1.5rem 2.8rem 1.5rem;
    text-align: center;
  }
  .page-title-cn {
    font-size: 2.2rem;
    font-weight: 800;
    margin-bottom: 0.6rem;
    letter-spacing: 2px;
  }
  .page-subtitle-cn {
    font-size: 1rem;
    color: #cbd5e1;
    font-weight: 400;
    letter-spacing: 0.5px;
    max-width: 800px;
    margin: 0 auto;
    line-height: 1.5;
  }

  /* 页面主体主容器 */
  .research-page-container {
    max-width: 1200px;
    margin: 2.5rem auto 4.5rem auto;
    padding: 0 1.25rem;
    box-sizing: border-box;
    overflow-x: hidden;
  }

  .research-cards-stack {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
  }

  /* 方向大卡片 (现代卡片质感) */
  .dir-card-modern {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 2rem 2.25rem;
    box-shadow: 0 4px 18px rgba(15, 23, 42, 0.04);
    transition: all 0.25s ease;
    overflow-wrap: break-word;
    word-break: break-word;
    box-sizing: border-box;
  }
  .dir-card-modern:hover {
    border-color: #93c5fd;
    box-shadow: 0 8px 24px rgba(2, 132, 199, 0.08);
  }

  /* 卡片头部 */
  .dir-card-header {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    border-bottom: 1px solid #f1f5f9;
    padding-bottom: 1.25rem;
    margin-bottom: 1.25rem;
  }

  .dir-num-badge {
    font-size: 2rem;
    font-weight: 900;
    font-family: Impact, "Arial Black", sans-serif;
    color: #0284c7;
    background: #f0f9ff;
    border: 1px solid #bae6fd;
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    flex-shrink: 0;
  }

  .dir-title-box {
    flex: 1;
    min-width: 0;
  }
  .dir-title-cn {
    font-size: 1.45rem;
    font-weight: 700;
    color: #0f172a;
    margin: 0;
    line-height: 1.35;
  }
  .dir-title-en {
    font-size: 0.88rem;
    color: #64748b;
    margin-top: 0.35rem;
    font-weight: 500;
    letter-spacing: 0.3px;
    overflow-wrap: break-word;
  }

  /* 简介概要框 */
  .dir-summary-box {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-left: 4px solid #0284c7;
    border-radius: 8px;
    padding: 1rem 1.25rem;
    margin-bottom: 1.5rem;
  }
  .dir-summary-text {
    font-size: 0.95rem;
    line-height: 1.8;
    color: #334155;
    margin: 0;
    text-align: justify;
    overflow-wrap: break-word;
  }

  /* 代表性成果模块 */
  .dir-pubs-section {
    margin-top: 0.5rem;
  }
  .dir-pubs-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    font-weight: 700;
    color: #0284c7;
    margin-bottom: 0.85rem;
  }
  .pubs-dot {
    width: 8px;
    height: 8px;
    background-color: #0284c7;
    border-radius: 50%;
    display: inline-block;
  }

  /* 成果列表与单篇卡片 */
  .dir-pubs-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .pub-item-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 1rem 1.25rem;
    transition: all 0.2s ease;
    box-sizing: border-box;
  }
  .pub-item-card:hover {
    background: #f8fafc;
    border-color: #93c5fd;
    box-shadow: 0 2px 10px rgba(15, 23, 42, 0.04);
  }

  /* 论文标题：严格断词，绝不横向撑爆页面 */
  .pub-paper-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: #0f172a;
    line-height: 1.5;
    margin: 0 0 0.45rem 0;
    word-break: break-word;
    overflow-wrap: break-word;
    hyphens: auto;
  }

  .pub-paper-meta {
    font-size: 0.86rem;
    color: #475569;
    line-height: 1.6;
    word-break: break-word;
    overflow-wrap: break-word;
  }
  .pub-authors {
    margin-right: 0.35rem;
  }
  .pub-authors :global(b) {
    color: #0284c7;
    font-weight: 700;
  }
  .pub-journal em {
    color: #0369a1;
    font-style: italic;
    font-weight: 600;
  }

  /* DOI 链接胶囊 */
  .pub-doi-wrap {
    margin-top: 0.5rem;
  }
  .pub-doi-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.78rem;
    color: #64748b;
    background: #f1f5f9;
    border: 1px solid #e2e8f0;
    border-radius: 4px;
    padding: 0.2rem 0.6rem;
    text-decoration: none;
    font-weight: 500;
    transition: all 0.15s ease;
    word-break: break-all;
    max-width: 100%;
  }
  .pub-doi-link:hover {
    color: #0284c7;
    background: #e0f2fe;
    border-color: #bae6fd;
    text-decoration: none;
  }
  .icon-external {
    flex-shrink: 0;
  }

  /* 移动端深度适配 (杜绝任何横向滚动) */
  @media (max-width: 768px) {
    .page-title-banner {
      padding: 2.25rem 1rem 1.75rem 1rem;
    }
    .page-title-cn {
      font-size: 1.65rem;
    }
    .page-subtitle-cn {
      font-size: 0.88rem;
    }

    .research-page-container {
      margin: 1.5rem auto 3rem auto;
      padding: 0 0.85rem;
    }
    .research-cards-stack {
      gap: 1.5rem;
    }

    .dir-card-modern {
      padding: 1.25rem 1rem;
      border-radius: 10px;
    }
    .dir-card-header {
      gap: 0.85rem;
      padding-bottom: 0.85rem;
      margin-bottom: 0.85rem;
    }
    .dir-num-badge {
      width: 46px;
      height: 46px;
      font-size: 1.45rem;
      border-radius: 8px;
    }
    .dir-title-cn {
      font-size: 1.15rem;
    }
    .dir-title-en {
      font-size: 0.76rem;
    }

    .dir-summary-box {
      padding: 0.75rem 0.85rem;
      margin-bottom: 1.15rem;
    }
    .dir-summary-text {
      font-size: 0.86rem;
      line-height: 1.65;
    }

    .pub-item-card {
      padding: 0.85rem;
    }
    .pub-paper-title {
      font-size: 0.88rem;
    }
    .pub-paper-meta {
      font-size: 0.8rem;
    }
  }
</style>
