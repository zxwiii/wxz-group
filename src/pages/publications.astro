---
import Layout from '../layouts/Layout.astro';
---

<Layout title="学术文章" activeNav="outputs">
  <div class="custom-embed-wrap" style="max-width: 1240px; margin: 1.5rem auto 3rem auto; padding: 0 1.5rem;">
    <!-- 用户原版文章.txt (无损嵌入) -->
    
<!-- 王小治教授课题组 (wxz.group) · 学术成果与影响力系统【双模块合一版 | 凡科单模块即插即用】 -->
<div id="wxz-unified-app">
<div id="wxz-i">
<div class="wxz-impact-card">
<div class="wxz-impact-header">
<div class="wxz-impact-title-group">
<h2 class="wxz-impact-main-title">学术影响力与科研引证概况</h2>
<span class="wxz-impact-sub-title">Prof. Xiaozhi Wang · Research Impact & Academic Profile</span>
</div>
<a class="wxz-impact-source-tag" href="https://www.webofscience.com/wos/author/record/PDX-5463-2025" target="_blank" rel="noopener noreferrer" title="点击查看 Web of Science 官方学者主页">
<span class="wxz-tag-dot"></span>Clarivate Web of Science 官方认证 ↗
</a>
</div>
<div class="wxz-impact-stats-grid">
<div class="wxz-stat-box">
<div class="wxz-stat-num" id="wxz-stat-cites">6,704<span class="wxz-plus">+</span></div>
<div class="wxz-stat-label">Web of Science 总被引频次</div>
<div class="wxz-stat-en">Sum of Times Cited</div>
</div>
<div class="wxz-stat-box">
<div class="wxz-stat-num" id="wxz-stat-hindex">44</div>
<div class="wxz-stat-label">Web of Science H 指数</div>
<div class="wxz-stat-en">h-index</div>
</div>
<div class="wxz-stat-box wxz-clickable-box" onclick="WxzImpactHelper.filter('feat', 'all')" title="点击查看全部收录论文">
<div class="wxz-stat-num" id="wxz-stat-pubs">202</div>
<div class="wxz-stat-label">核心合集收录论文 ↗</div>
<div class="wxz-stat-en">Core Collection Publications</div>
</div>
<div class="wxz-stat-box wxz-high-impact-box">
<div class="wxz-impact-tags-title">高水平学术成果精选</div>
<div class="wxz-impact-quick-tags">
<button type="button" class="wxz-quick-tag tag-feat" onclick="WxzImpactHelper.filter('feat', 'featured')" title="点击筛选 12 篇顶刊代表作">
★ 代表作 <strong id="wxz-cnt-feat">12</strong> 篇
</button>
<button type="button" class="wxz-quick-tag tag-esi" onclick="WxzImpactHelper.filter('feat', 'esi')" title="点击筛选 ESI 高被引论文">
 ESI高被引 <strong id="wxz-cnt-esi">7</strong> 篇
</button>
<button type="button" class="wxz-quick-tag tag-role" onclick="WxzImpactHelper.filter('feat', 'role')" title="点击筛选通讯或第一作者论文">
 通讯/一作 <strong id="wxz-cnt-role">113</strong> 篇
</button>
</div>
<div class="wxz-stat-en">High Impact Publications</div>
</div>
</div>
<div class="wxz-impact-charts-row">
<div class="wxz-chart-panel wxz-trend-panel">
<div class="wxz-panel-header">
<span class="wxz-panel-title"> 年度发表论文与被引增长趋势 (2016–2026)</span>
<span class="wxz-panel-hint">点击年份柱体可快速筛选</span>
</div>
<div class="wxz-trend-bars" id="wxz-trend-container">
<div style="font-size:12px;color:#94a3b8;margin:auto;">正在加载年度学术趋势数据...</div>
</div>
<div class="wxz-trend-summary">
<span>⚡ 近5年年均发文 30+ 篇</span>
<span class="wxz-dot">·</span>
<span> 成果引证呈持续爆发式增长</span>
</div>
</div>
<div class="wxz-chart-panel">
<div class="wxz-panel-header">
<span class="wxz-panel-title"> 核心学科领域与重点顶刊分布</span>
<span class="wxz-panel-hint">点击主题/期刊直接筛选</span>
</div>
<div class="wxz-topics-bars" id="wxz-topics-container">
<div style="font-size:12px;color:#94a3b8;margin:auto;">正在加载学科领域分布数据...</div>
</div>
<div class="wxz-journal-pills" id="wxz-journals-container">
</div>
</div>
</div>
<div class="wxz-impact-footer">
<span class="wxz-footer-item">
<span class="wxz-live-dot" title="Web of Science 官方云端实时同步运行中"></span>
数据自动更新至：<strong id="wxz-impact-date" style="color:#0f172a;margin-left:3px;">2026年10月26日</strong>
</span>
<span class="wxz-impact-dot">·</span>
<span class="wxz-footer-item">数据源：Clarivate Web of Science (核心合集官方数据库)</span>
<span class="wxz-impact-dot">·</span>
<span class="wxz-footer-item">学者档案：<a href="https://www.webofscience.com/wos/author/record/PDX-5463-2025" target="_blank" rel="noopener noreferrer" style="color:#1e50ae;text-decoration:none;font-weight:600;">PDX-5463-2025 ↗</a></span>
</div>
</div>
</div>
<div id="wxz-p" class="wxz-pub-wrapper">
<div class="wxz-pub-control-card">
<div class="wxz-pub-top-row">
<div class="wxz-pub-stat-group">
<span class="wxz-pub-badge-total" id="wxz-stat-total">成果加载中...</span>
<span class="wxz-pub-badge-filtered" id="wxz-stat-filtered" style="display:none;">当前显示 0 篇</span>
<button type="button" class="wxz-pub-btn-reset" id="wxz-btn-reset" onclick="WxzPubApp.resetFilters()">
<svg viewBox="0 0 24 24" width="13" height="13"><path fill="currentColor" d="M17.65 6.35A7.958 7.958 0 0 0 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0 1 12 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/></svg>
<span id="wxz-txt-reset">重置筛选</span>
</button>
</div>
<div class="wxz-pub-right-controls">
<div class="wxz-pub-sort-switch">
<span class="wxz-sort-label" id="wxz-lbl-sort">排序：</span>
<button type="button" class="wxz-sort-btn active" id="wxz-btn-sort-date" onclick="WxzPubApp.setSort('date')"> 最新发表</button>
<button type="button" class="wxz-sort-btn" id="wxz-btn-sort-cites" onclick="WxzPubApp.setSort('cites')"> 被引频次</button>
</div>
<div class="wxz-pub-lang-switch">
<button type="button" class="wxz-lang-btn active" id="wxz-btn-lang-zh" onclick="WxzPubApp.setLanguage('zh')">中文</button>
<button type="button" class="wxz-lang-btn" id="wxz-btn-lang-en" onclick="WxzPubApp.setLanguage('en')">EN</button>
</div>
</div>
</div>
<div class="wxz-pub-search-box">
<span class="wxz-pub-search-icon">
<svg viewBox="0 0 24 24" width="17" height="17"><path fill="currentColor" d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
</span>
<input type="text" id="wxz-search-input" placeholder="输入论文标题、期刊名称、作者(如 Wang, Xiaozhi)、年份或DOI实时检索..." oninput="WxzPubApp.onSearchInput()" />
<button type="button" id="wxz-search-clear" class="wxz-pub-search-clear" onclick="WxzPubApp.clearSearch()" style="display:none;">&times;</button>
</div>
<div class="wxz-pub-filters-panel">
<div class="wxz-pub-filter-row">
<span class="wxz-filter-label" id="wxz-lbl-topj">重点期刊：</span>
<div class="wxz-filter-tags" id="wxz-tags-topj">
<button type="button" class="wxz-tag-btn active" data-type="topj" data-val="all" onclick="WxzPubApp.toggleFilter('topj', 'all')" id="wxz-topj-all">全部</button>
<button type="button" class="wxz-tag-btn wxz-topj-badge wxz-angew" data-type="topj" data-val="Angew" onclick="WxzPubApp.toggleFilter('topj', 'Angew')">Angew</button>
<button type="button" class="wxz-tag-btn wxz-topj-badge wxz-est" data-type="topj" data-val="EST" onclick="WxzPubApp.toggleFilter('topj', 'EST')">EST</button>
<button type="button" class="wxz-tag-btn wxz-topj-badge wxz-wr" data-type="topj" data-val="WR" onclick="WxzPubApp.toggleFilter('topj', 'WR')">WR</button>
<button type="button" class="wxz-tag-btn wxz-topj-badge wxz-acsnano" data-type="topj" data-val="ACS Nano" onclick="WxzPubApp.toggleFilter('topj', 'ACS Nano')">ACS Nano</button>
<button type="button" class="wxz-tag-btn wxz-topj-badge wxz-advsci" data-type="topj" data-val="Adv Sci" onclick="WxzPubApp.toggleFilter('topj', 'Adv Sci')">Adv Sci</button>
<button type="button" class="wxz-tag-btn wxz-topj-badge wxz-acb wxz-applcatalb" data-type="topj" data-val="Appl. Catal. B" onclick="WxzPubApp.toggleFilter('topj', 'Appl. Catal. B')">Appl. Catal. B</button>
<button type="button" class="wxz-tag-btn wxz-topj-badge wxz-cej" data-type="topj" data-val="CEJ" onclick="WxzPubApp.toggleFilter('topj', 'CEJ')">CEJ</button>
</div>
</div>
<div class="wxz-pub-filter-row">
<span class="wxz-filter-label" id="wxz-lbl-feat">精选成果：</span>
<div class="wxz-filter-tags" id="wxz-tags-feat">
<button type="button" class="wxz-tag-btn" data-type="feat" data-val="all" onclick="WxzPubApp.toggleFilter('feat', 'all')" id="wxz-tag-all">全部</button>
<button type="button" class="wxz-tag-btn wxz-featured-tag active" data-type="feat" data-val="featured" onclick="WxzPubApp.toggleFilter('feat', 'featured')" id="wxz-tag-feat">★ 代表作 Selected</button>
<button type="button" class="wxz-tag-btn wxz-esi-tag" data-type="feat" data-val="esi" onclick="WxzPubApp.toggleFilter('feat', 'esi')" id="wxz-tag-esi"> ESI高被引</button>
<button type="button" class="wxz-tag-btn wxz-role-tag" data-type="feat" data-val="role" onclick="WxzPubApp.toggleFilter('feat', 'role')" id="wxz-tag-role"> 通讯/第一作者</button>
</div>
</div>
<div class="wxz-pub-filter-row">
<span class="wxz-filter-label" id="wxz-lbl-year">发表年份：</span>
<div class="wxz-filter-tags" id="wxz-tags-year">
<button type="button" class="wxz-tag-btn active" data-type="year" data-val="all" onclick="WxzPubApp.toggleFilter('year', 'all')" id="wxz-year-all">全部</button>
</div>
</div>
<div class="wxz-pub-filter-row">
<span class="wxz-filter-label" id="wxz-lbl-topic">研究方向：</span>
<div class="wxz-filter-tags" id="wxz-tags-topic">
<button type="button" class="wxz-tag-btn active" data-type="topic" data-val="all" onclick="WxzPubApp.toggleFilter('topic', 'all')" id="wxz-topic-all">全部</button>
<button type="button" class="wxz-tag-btn" data-type="topic" data-val="光催化与环境材料" onclick="WxzPubApp.toggleFilter('topic', '光催化与环境材料')">光催化与环境材料</button>
<button type="button" class="wxz-tag-btn" data-type="topic" data-val="生物炭与多孔材料" onclick="WxzPubApp.toggleFilter('topic', '生物炭与多孔材料')">生物炭与多孔材料</button>
<button type="button" class="wxz-tag-btn" data-type="topic" data-val="高级氧化与铁循环" onclick="WxzPubApp.toggleFilter('topic', '高级氧化与铁循环')">高级氧化与铁循环</button>
<button type="button" class="wxz-tag-btn" data-type="topic" data-val="重金属吸附与修复" onclick="WxzPubApp.toggleFilter('topic', '重金属吸附与修复')">重金属吸附与修复</button>
<button type="button" class="wxz-tag-btn" data-type="topic" data-val="土壤生态与碳氮循环" onclick="WxzPubApp.toggleFilter('topic', '土壤生态与碳氮循环')">土壤生态与碳氮循环</button>
<button type="button" class="wxz-tag-btn" data-type="topic" data-val="新兴污染物与健康" onclick="WxzPubApp.toggleFilter('topic', '新兴污染物与健康')">新兴污染物与健康</button>
</div>
</div>
</div>
</div>
<div class="wxz-pub-list" id="wxz-pub-list">
</div>
<div class="wxz-pub-empty-state" id="wxz-pub-empty" style="display:none;">
<div class="wxz-empty-icon"></div>
<h3 id="wxz-empty-title">未找到匹配的学术成果</h3>
<p id="wxz-empty-desc">请尝试更换检索关键词或重置上方筛选条件。</p>
<button type="button" class="wxz-pub-btn-reset-inline" onclick="WxzPubApp.resetFilters()">重置筛选条件</button>
</div>
</div>
</div>
<style is:global>
#wxz-unified-app {
width: 100% !important;
max-width: 1200px !important;
margin: 0 auto 30px auto !important;
padding: 0 !important;
box-sizing: border-box !important;
}
#wxz-unified-app *, #wxz-unified-app *::before, #wxz-unified-app *::after {
box-sizing: border-box !important;
}
#wxz-i{width:100%;max-width:1200px;margin:0 auto 18px auto;padding:0;box-sizing:border-box;overflow-x:hidden;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"PingFang SC","Microsoft YaHei",sans-serif;color:#1e293b;line-height:1.5;text-align:left}
#wxz-i *{box-sizing:border-box;max-width:100%}
#wxz-i .wxz-impact-card{background:#ffffff;border:1px solid #cbd5e1;border-top:4px solid #1e50ae;border-radius:8px;padding:20px 24px;box-shadow:0 4px 14px rgba(30,80,174,0.06)}
#wxz-i .wxz-impact-header{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:12px;padding-bottom:14px;border-bottom:1px solid #e2e8f0;margin-bottom:18px}
#wxz-i .wxz-impact-main-title{font-size:21px;font-weight:700;color:#1e50ae;margin:0 0 4px 0;letter-spacing:0.3px}
#wxz-i .wxz-impact-sub-title{font-family:"Georgia","Times New Roman",serif;font-size:13.5px;color:#64748b}
#wxz-i .wxz-impact-source-tag{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:600;color:#1e50ae;background:#eff6ff;border:1px solid #bfdbfe;padding:4px 12px;border-radius:20px;text-decoration:none;transition:all 0.2s ease}
#wxz-i .wxz-impact-source-tag:hover{background:#1e50ae;color:#ffffff}
#wxz-i .wxz-tag-dot{width:6px;height:6px;background:#0284c7;border-radius:50%}
#wxz-i .wxz-impact-stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:20px}
#wxz-i .wxz-stat-box{background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:14px 14px;text-align:center;transition:all 0.2s ease;display:flex;flex-direction:column;justify-content:center}
#wxz-i .wxz-stat-box:hover{border-color:#93c5fd;background:#ffffff;transform:translateY(-2px);box-shadow:0 4px 12px rgba(30,80,174,0.08)}
#wxz-i .wxz-clickable-box{cursor:pointer}
#wxz-i .wxz-clickable-box:hover .wxz-stat-label{color:#1e50ae}
#wxz-i .wxz-stat-num{font-family:"Georgia","Times New Roman",serif;font-size:32px;font-weight:700;color:#1e50ae;line-height:1.1;margin-bottom:5px}
#wxz-i .wxz-plus{font-size:20px;color:#0284c7;margin-left:2px}
#wxz-i .wxz-stat-label{font-size:13px;font-weight:700;color:#334155;margin-bottom:2px}
#wxz-i .wxz-stat-en{font-size:10.5px;color:#94a3b8;text-transform:uppercase;letter-spacing:0.5px}
#wxz-i .wxz-high-impact-box{padding:10px 10px;background:#ffffff}
#wxz-i .wxz-impact-tags-title{font-size:12.5px;font-weight:700;color:#1e293b;margin-bottom:6px}
#wxz-i .wxz-impact-quick-tags{display:flex;flex-direction:column;gap:4px;margin-bottom:4px}
#wxz-i .wxz-quick-tag{display:flex;align-items:center;justify-content:space-between;padding:3px 8px;font-size:11.5px;font-weight:600;border-radius:4px;cursor:pointer;border:1px solid transparent;transition:all 0.15s ease;text-align:left}
#wxz-i .wxz-quick-tag.tag-feat{background:#fff1f2;color:#c40000;border-color:#fecdd3}
#wxz-i .wxz-quick-tag.tag-feat:hover{background:#c40000;color:#ffffff}
#wxz-i .wxz-quick-tag.tag-esi{background:#fffbeb;color:#b45309;border-color:#fde68a}
#wxz-i .wxz-quick-tag.tag-esi:hover{background:#b45309;color:#ffffff}
#wxz-i .wxz-quick-tag.tag-role{background:#eff6ff;color:#1e50ae;border-color:#bfdbfe}
#wxz-i .wxz-quick-tag.tag-role:hover{background:#1e50ae;color:#ffffff}
#wxz-i .wxz-impact-charts-row{display:grid;grid-template-columns:1.1fr 1fr;gap:16px;margin-bottom:18px}
#wxz-i .wxz-chart-panel{background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:16px 18px}
#wxz-i .wxz-panel-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px}
#wxz-i .wxz-panel-title{font-size:13.5px;font-weight:700;color:#1e293b}
#wxz-i .wxz-panel-hint{font-size:11px;color:#0369a1;background:#e0f2fe;padding:2px 8px;border-radius:4px;font-weight:600}
#wxz-i .wxz-trend-panel{display:flex;flex-direction:column;justify-content:space-between}
#wxz-i .wxz-trend-bars{display:flex;align-items:flex-end;justify-content:space-between;height:195px;padding:16px 4px 6px 4px;border-bottom:1px solid #cbd5e1;gap:6px;flex:1}
#wxz-i .wxz-bar-item{flex:1;display:flex;flex-direction:column;align-items:center;height:100%;justify-content:flex-end;cursor:pointer;transition:transform 0.15s ease}
#wxz-i .wxz-bar-item:hover{transform:translateY(-2px)}
#wxz-i .wxz-bar-val{font-size:10.5px;font-weight:700;color:#475569;margin-bottom:4px;font-family:"Georgia",serif;line-height:1}
#wxz-i .wxz-bar-item:hover .wxz-bar-val{color:#1e50ae}
#wxz-i .wxz-bar{width:80%;max-width:18px;background:#93c5fd;border-radius:3px 3px 0 0;transition:all 0.25s ease}
#wxz-i .wxz-bar.highlight{background:#1e50ae}
#wxz-i .wxz-bar-item:hover .wxz-bar{background:#0284c7;transform:scaleY(1.05)}
#wxz-i .wxz-bar-yr{font-size:10.5px;color:#64748b;margin-top:6px;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif}
#wxz-i .wxz-trend-summary{display:flex;align-items:center;justify-content:center;gap:8px;font-size:11.5px;color:#64748b;padding-top:10px;font-weight:500}
#wxz-i .wxz-trend-summary .wxz-dot{color:#cbd5e1}
#wxz-i .wxz-topics-bars{display:flex;flex-direction:column;gap:8px;margin-bottom:12px}
#wxz-i .wxz-topic-row{display:flex;align-items:center;font-size:12px;gap:8px;cursor:pointer;padding:2px 4px;border-radius:4px;transition:background 0.15s ease}
#wxz-i .wxz-topic-row:hover{background:#e2e8f0}
#wxz-i .wxz-topic-name{width:120px;color:#1e293b;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#wxz-i .wxz-topic-track{flex:1;height:7px;background:#e2e8f0;border-radius:4px;overflow:hidden}
#wxz-i .wxz-topic-fill{height:100%;background:linear-gradient(90deg,#1e50ae 0%,#0284c7 100%);border-radius:4px}
#wxz-i .wxz-topic-val{width:44px;text-align:right;font-size:11.5px;color:#475569;font-family:"Georgia",serif;font-weight:600}
#wxz-i .wxz-journal-pills{display:flex;flex-wrap:wrap;gap:6px;padding-top:8px;border-top:1px dashed #e2e8f0}
#wxz-i .wxz-jpill{font-size:11px;font-weight:600;padding:3px 8px;border-radius:4px;background:#ffffff;border:1px solid #cbd5e1;color:#334155;cursor:pointer;transition:all 0.15s ease}
#wxz-i .wxz-jpill:hover{transform:translateY(-1px);box-shadow:0 2px 6px rgba(15,23,42,0.1)}
#wxz-i .wxz-jpill.angew{border-color:#fca5a5;color:#b91c1c}
#wxz-i .wxz-jpill.est{border-color:#7dd3fc;color:#0369a1}
#wxz-i .wxz-jpill.wr{border-color:#5eead4;color:#0f766e}
#wxz-i .wxz-jpill.acsnano{border-color:#fcd34d;color:#b45309}
#wxz-i .wxz-jpill.advsci{border-color:#c4b5fd;color:#6d28d9}
#wxz-i .wxz-jpill.acb,#wxz-i .wxz-jpill.applcatalb{border-color:#6ee7b7;color:#047857}
#wxz-i .wxz-jpill.cej{border-color:#93c5fd;color:#1d4ed8}
#wxz-i .wxz-live-dot{display:inline-block;width:8px;height:8px;background-color:#10b981;border-radius:50%;margin-right:6px;box-shadow:0 0 0 0 rgba(16,185,129,0.7);animation:wxz-pulse 2s infinite;flex-shrink:0}
@keyframes wxz-pulse{0%{transform:scale(0.95);box-shadow:0 0 0 0 rgba(16,185,129,0.7)}
70%{transform:scale(1);box-shadow:0 0 0 6px rgba(16,185,129,0)}
