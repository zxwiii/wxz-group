(function() {
function renderImpactUI() {
var d = window.WXZ_IMPACT;
if (!d || !d.stats) return;
var s = d.stats;
var elCites = document.getElementById("wxz-stat-cites");
var elH = document.getElementById("wxz-stat-hindex");
var elPubs = document.getElementById("wxz-stat-pubs");
var elFeat = document.getElementById("wxz-cnt-feat");
var elEsi = document.getElementById("wxz-cnt-esi");
var elRole = document.getElementById("wxz-cnt-role");
var elDate = document.getElementById("wxz-impact-date");
if (elCites) elCites.innerHTML = Number(s.total_citations).toLocaleString() + '<span class="wxz-plus">+</span>';
if (elH) elH.innerText = s.h_index;
if (elPubs) elPubs.innerText = s.total_publications;
if (elFeat && s.featured_count) elFeat.innerText = s.featured_count;
if (elEsi && s.esi_count) elEsi.innerText = s.esi_count;
if (elRole && s.role_count) elRole.innerText = s.role_count;
if (elDate && d.updated_at) elDate.innerText = d.updated_at;
if (d.year_trend && d.year_trend.length > 0) {
var container = document.getElementById("wxz-trend-container");
if (container) {
var maxP = 1;
d.year_trend.forEach(function(item) { if (item.publications > maxP) maxP = item.publications; });
var html = "";
d.year_trend.forEach(function(item) {
var pct = Math.max(12, Math.round((item.publications / maxP) * 100));
var isLatest = item.year === 2025;
var yrShort = "'" + String(item.year).slice(-2);
var titleStr = item.year + "年: 发表 " + item.publications + " 篇, 实时被引 " + item.citations + " 次 (点击筛选)";
html += '<div class="wxz-bar-item" title="' + titleStr + '" onclick="WxzImpactHelper.filter(\'year\', ' + item.year + ')">';
html += '<span class="wxz-bar-val">' + item.publications + '</span>';
html += '<div class="wxz-bar' + (isLatest ? ' highlight' : '') + '" style="height:' + pct + '%;"></div>';
html += '<span class="wxz-bar-yr">' + yrShort + '</span>';
html += '</div>';
});
container.innerHTML = html;
}
}
if (d.topics_distribution) {
var topicsContainer = document.getElementById("wxz-topics-container");
if (topicsContainer) {
var maxT = 1;
for (var k in d.topics_distribution) {
if (d.topics_distribution[k] > maxT) maxT = d.topics_distribution[k];
}
var topicsHtml = "";
for (var name in d.topics_distribution) {
var count = d.topics_distribution[name];
var pct = Math.max(10, Math.round((count / maxT) * 100));
topicsHtml += '<div class="wxz-topic-row" onclick="WxzImpactHelper.filter(\'topic\', \'' + name + '\')" title="点击筛选【' + name + '】成果">';
topicsHtml += '  <span class="wxz-topic-name">' + name + '</span>';
topicsHtml += '  <div class="wxz-topic-track"><div class="wxz-topic-fill" style="width: ' + pct + '%;"></div></div>';
topicsHtml += '  <span class="wxz-topic-val">' + count + ' 篇</span>';
topicsHtml += '</div>';
}
topicsContainer.innerHTML = topicsHtml;
}
}
if (d.top_journals && d.top_journals.length > 0) {
var jContainer = document.getElementById("wxz-journals-container");
if (jContainer) {
var jHtml = "";
d.top_journals.forEach(function(tj) {
var cls = tj.abbr.toLowerCase().replace(/[^a-z]/g, "");
jHtml += '<button type="button" class="wxz-jpill ' + cls + '" title="点击筛选 ' + tj.name + ' 成果" onclick="WxzImpactHelper.filter(\'topj\', \'' + tj.abbr + '\')">' + tj.abbr + ' (' + tj.count + ')</button>';
});
jContainer.innerHTML = jHtml;
}
}
}
