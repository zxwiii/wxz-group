window.WxzPubApp = {
init: function() {
var self = this;
if (window.WXZ_PUBLICATIONS && window.WXZ_PUBLICATIONS.length > 0) {
RAW_DATA = window.WXZ_PUBLICATIONS;
self.initYearFilters();
self.render();
} else {
var timer = setInterval(function() {
if (window.WXZ_PUBLICATIONS && window.WXZ_PUBLICATIONS.length > 0) {
clearInterval(timer);
RAW_DATA = window.WXZ_PUBLICATIONS;
self.initYearFilters();
self.render();
}
}, 80);
setTimeout(function() { clearInterval(timer); }, 6000);
}
},
initYearFilters: function() {
var container = document.getElementById("wxz-tags-year");
if (!container) return;
var years = [];
RAW_DATA.forEach(function(item) {
if (item.year && years.indexOf(item.year) === -1) {
years.push(item.year);
}
});
years.sort(function(a, b) { return b - a; });
var recentYears = years.filter(function(y) { return y >= 2018; });
var html = '<button type="button" class="wxz-tag-btn active" data-type="year" data-val="all" onclick="WxzPubApp.toggleFilter(\'year\', \'all\')" id="wxz-year-all">全部</button>';
recentYears.forEach(function(y) {
var cnt = RAW_DATA.filter(function(p) { return p.year === y; }).length;
html += '<button type="button" class="wxz-tag-btn" data-type="year" data-val="' + y + '" onclick="WxzPubApp.toggleFilter(\'year\', ' + y + ')">' + y + ' (' + cnt + ')</button>';
});
var olderCount = RAW_DATA.filter(function(p) { return p.year && p.year <= 2017; }).length;
if (olderCount > 0) {
html += '<button type="button" class="wxz-tag-btn" data-type="year" data-val="older" onclick="WxzPubApp.toggleFilter(\'year\', \'older\')">2017及以前 (' + olderCount + ')</button>';
}
container.innerHTML = html;
},
setSort: function(mode) {
state.sort = mode;
document.getElementById("wxz-btn-sort-date").classList.toggle("active", mode === "date");
document.getElementById("wxz-btn-sort-cites").classList.toggle("active", mode === "cites");
this.render();
},
