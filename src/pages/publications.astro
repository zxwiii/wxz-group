document.getElementById("wxz-btn-lang-zh").classList.toggle("active", lang === "zh");
document.getElementById("wxz-btn-lang-en").classList.toggle("active", lang === "en");
var t = I18N[lang];
document.getElementById("wxz-txt-reset").innerText = t.reset;
document.getElementById("wxz-lbl-sort").innerText = t.lblSort;
document.getElementById("wxz-btn-sort-date").innerText = t.sortDate;
document.getElementById("wxz-btn-sort-cites").innerText = t.sortCites;
document.getElementById("wxz-search-input").placeholder = t.searchPlaceholder;
document.getElementById("wxz-lbl-topj").innerText = t.lblTopj;
document.getElementById("wxz-lbl-feat").innerText = t.lblFeat;
document.getElementById("wxz-lbl-year").innerText = t.lblYear;
document.getElementById("wxz-lbl-topic").innerText = t.lblTopic;
document.getElementById("wxz-tag-all").innerText = t.all;
document.getElementById("wxz-tag-feat").innerText = t.tagFeat;
document.getElementById("wxz-tag-esi").innerText = t.tagEsi;
document.getElementById("wxz-tag-role").innerText = t.tagRole;
document.getElementById("wxz-topj-all").innerText = t.all;
document.getElementById("wxz-year-all").innerText = t.all;
document.getElementById("wxz-topic-all").innerText = t.all;
document.getElementById("wxz-empty-title").innerText = t.emptyTitle;
document.getElementById("wxz-empty-desc").innerText = t.emptyDesc;
var topicButtons = document.querySelectorAll("#wxz-tags-topic .wxz-tag-btn");
topicButtons.forEach(function(btn) {
