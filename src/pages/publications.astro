function highlightAuthors(authorsStr) {
if (!authorsStr) return "";
var regex = /\b(Wang[,\s]+(?:Xiao-?Zhi|XZ|X\b)|Xiao-?Zhi[,\s]+Wang|王小治)\b/gi;
return authorsStr.replace(regex, function(matched) {
