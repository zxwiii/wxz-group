},
onSearchInput: function() {
var val = document.getElementById("wxz-search-input").value.trim();
state.search = val.toLowerCase();
document.getElementById("wxz-search-clear").style.display = val ? "block" : "none";
this.render();
},
clearSearch: function() {
document.getElementById("wxz-search-input").value = "";
state.search = "";
document.getElementById("wxz-search-clear").style.display = "none";
this.render();
},
toggleFilter: function(type, val) {
state[type] = val;
var buttons = document.querySelectorAll('#wxz-p .wxz-tag-btn[data-type="' + type + '"]');
buttons.forEach(function(btn) {
var btnVal = btn.getAttribute("data-val");
if (type === "year") {
btn.classList.toggle("active", String(btnVal) === String(state.year));
} else {
btn.classList.toggle("active", btnVal === state[type]);
}
});
this.render();
},
resetFilters: function() {
state.search = "";
state.topj = "all";
state.feat = "all";
state.year = "all";
state.topic = "all";
document.getElementById("wxz-search-input").value = "";
document.getElementById("wxz-search-clear").style.display = "none";
document.querySelectorAll("#wxz-p .wxz-tag-btn").forEach(function(btn) {
btn.classList.remove("active");
});
var topjAll = document.getElementById("wxz-topj-all");
var featAll = document.getElementById("wxz-tag-all");
var yearAll = document.getElementById("wxz-year-all");
var topicAll = document.getElementById("wxz-topic-all");
if (topjAll) topjAll.classList.add("active");
if (featAll) featAll.classList.add("active");
if (yearAll) yearAll.classList.add("active");
if (topicAll) topicAll.classList.add("active");
this.render();
},
render: function() {
var t = I18N[state.lang];
var listEl = document.getElementById("wxz-pub-list");
var emptyEl = document.getElementById("wxz-pub-empty");
var totalBadge = document.getElementById("wxz-stat-total");
var filteredBadge = document.getElementById("wxz-stat-filtered");
if (totalBadge) {
totalBadge.innerText = t.totalBadge.replace("{n}", RAW_DATA.length);
}
var filtered = RAW_DATA.filter(function(item) {
if (state.search) {
var text = ((item.title || "") + " " + (item.authors || "") + " " + (item.journal || "") + " " + (item.year || "") + " " + (item.doi || "")).toLowerCase();
if (text.indexOf(state.search) === -1) return false;
}
if (state.topj !== "all") {
var matchTopJ = false;
if (item.top_journal === state.topj) {
matchTopJ = true;
} else if ((state.topj === "Appl. Catal. B" || state.topj === "ACB") && (item.top_journal === "Appl. Catal. B" || item.top_journal === "ACB")) {
matchTopJ = true;
} else if ((state.topj === "Appl. Catal. B" || state.topj === "ACB") && item.journal && /applied\s+catalysis\s+b/i.test(item.journal)) {
matchTopJ = true;
}
if (!matchTopJ) return false;
}
if (state.feat === "featured" && !item.is_featured) return false;
if (state.feat === "esi" && !item.is_esi) return false;
if (state.feat === "role" && !(item.is_first || item.is_corresponding)) return false;
if (state.year !== "all") {
if (state.year === "older") {
if (item.year > 2017) return false;
} else {
if (Number(item.year) !== Number(state.year)) return false;
}
}
if (state.topic !== "all") {
if (!item.topics || item.topics.indexOf(state.topic) === -1) return false;
}
return true;
});
if (state.sort === "cites") {
filtered.sort(function(a, b) {
if ((b.citations || 0) !== (a.citations || 0)) {
return (b.citations || 0) - (a.citations || 0);
}
return (b.id || 0) - (a.id || 0);
});
} else if (state.feat === "featured") {
filtered.sort(function(a, b) {
return getCardSortWeight(b) - getCardSortWeight(a);
});
} else {
filtered.sort(function(a, b) {
if (b.year !== a.year) return (b.year || 0) - (a.year || 0);
return (b.id || 0) - (a.id || 0);
});
}
var isFiltering = (state.search || state.topj !== "all" || state.feat !== "all" || state.year !== "all" || state.topic !== "all");
if (filteredBadge) {
if (isFiltering) {
filteredBadge.style.display = "inline-block";
filteredBadge.innerText = t.filteredBadge.replace("{n}", filtered.length);
} else {
filteredBadge.style.display = "none";
}
}
if (filtered.length === 0) {
listEl.innerHTML = "";
emptyEl.style.display = "block";
return;
}
emptyEl.style.display = "none";
var cardsHtml = "";
filtered.forEach(function(item) {
var cardClass = "wxz-pub-card";
if (item.is_featured) cardClass += " is-featured-card";
var doiUrl = item.doi ? "https://doi.org/" + item.doi : "#";
var highlightedAuthorsStr = highlightAuthors(item.authors || "");
var badgesHtml = "";
if (item.top_journal) {
var cls = item.top_journal.toLowerCase().replace(/[^a-z]/g, "");
badgesHtml += '<button type="button" class="wxz-badge-pill wxz-' + cls + '" title="点击筛选 ' + item.top_journal + ' 成果" onclick="WxzPubApp.toggleFilter(\'topj\', \'' + item.top_journal + '\')">' + item.top_journal + '</button>';
}
if (item.is_featured) {
badgesHtml += '<button type="button" class="wxz-badge-pill pill-feat" title="点击筛选精选代表作" onclick="WxzPubApp.toggleFilter(\'feat\', \'featured\')">★ Selected</button>';
}
if (item.is_esi) {
badgesHtml += '<button type="button" class="wxz-badge-pill pill-esi" title="点击筛选 ESI 高水平论文" onclick="WxzPubApp.toggleFilter(\'feat\', \'esi\')"> ESI</button>';
}
if (item.is_first && item.is_corresponding) {
badgesHtml += '<button type="button" class="wxz-badge-pill pill-role" title="点击筛选通讯/一作论文" onclick="WxzPubApp.toggleFilter(\'feat\', \'role\')">' + t.roleBoth + '</button>';
} else if (item.is_first) {
badgesHtml += '<button type="button" class="wxz-badge-pill pill-role" title="点击筛选通讯/一作论文" onclick="WxzPubApp.toggleFilter(\'feat\', \'role\')">' + t.roleFirst + '</button>';
} else if (item.is_corresponding) {
badgesHtml += '<button type="button" class="wxz-badge-pill pill-role" title="点击筛选通讯/一作论文" onclick="WxzPubApp.toggleFilter(\'feat\', \'role\')">' + t.roleCorr + '</button>';
}
if (typeof item.citations !== 'undefined') {
badgesHtml += '<span class="wxz-badge-pill pill-cite">' + t.citePrefix + (item.citations || 0) + t.citeSuffix + '</span>';
}
if (item.topics && item.topics.length > 0) {
item.topics.forEach(function(tp) {
var displayTp = (state.lang === 'en' && t.topics[tp]) ? t.topics[tp] : tp;
badgesHtml += '<button type="button" class="wxz-badge-pill pill-topic" title="点击筛选【' + tp + '】成果" onclick="WxzPubApp.toggleFilter(\'topic\', \'' + tp + '\')">' + displayTp + '</button>';
});
}
var titleLinkHtml = item.doi ? ('<a href="' + doiUrl + '" target="_blank" rel="noopener noreferrer">' + item.title + '</a>') : item.title;
var titleRowHtml = '<div class="wxz-paper-title-box">' +
'<span class="wxz-paper-num">' + item.id + '.</span>' +
'<div class="wxz-paper-title-text">' + titleLinkHtml + '</div>' +
'</div>';
var cleanPages = (item.pages || "").trim();
if (cleanPages.indexOf("{") !== -1 || cleanPages.indexOf("count") !== -1) {
cleanPages = "";
}
var volIssPage = "";
if (item.volume && cleanPages) {
volIssPage = ", " + item.volume + (item.issue ? "(" + item.issue + ")" : "") + ": " + cleanPages;
} else if (item.volume) {
volIssPage = ", " + item.volume + (item.issue ? "(" + item.issue + ")" : "");
} else if (cleanPages) {
volIssPage = ", " + cleanPages;
}
var doiInlineHtml = item.doi ? (' <span class="wxz-doi-inline">DOI: <a href="' + doiUrl + '" target="_blank" rel="noopener noreferrer">' + item.doi + '</a></span>') : '';
var fullCitation = (item.authors || "") + ". " + (item.title || "") + ". " + (item.journal || "") + ", " + (item.year || "") + volIssPage + "." + (item.doi ? (" https://doi.org/" + item.doi) : "");
var citeAttr = encodeURIComponent(fullCitation);
cardsHtml += '<div class="' + cardClass + '">';
if (badgesHtml) {
cardsHtml += '  <div class="wxz-badge-row">' + badgesHtml + '</div>';
}
cardsHtml += titleRowHtml;
cardsHtml += '  <div class="wxz-paper-authors">' + highlightedAuthorsStr + '</div>';
cardsHtml += '  <div class="wxz-paper-citation">';
cardsHtml += '    <span class="wxz-paper-journal">' + (item.journal || "Journal") + '</span>, ';
cardsHtml += '    <span class="wxz-paper-year">' + (item.year || "") + '</span>';
cardsHtml += '    <span class="wxz-paper-vol">' + volIssPage + '</span>.';
cardsHtml += doiInlineHtml;
cardsHtml += '  </div>';
cardsHtml += '  <div class="wxz-card-actions">';
if (item.doi) {
cardsHtml += '    <a class="wxz-action-btn wxz-btn-doi" href="' + doiUrl + '" target="_blank" rel="noopener noreferrer">' + t.btnDoi + '</a>';
}
cardsHtml += '    <button type="button" class="wxz-action-btn wxz-btn-copy" onclick="WxzPubApp.copyCitation(this, \'' + citeAttr + '\')">' + t.btnCopy + '</button>';
cardsHtml += '  </div>';
cardsHtml += '</div>';
});
listEl.innerHTML = cardsHtml;
},
copyCitation: function(btn, encodedStr) {
var raw = decodeURIComponent(encodedStr);
var t = I18N[state.lang];
var oldHtml = btn.innerHTML;
var fallback = function() {
var input = document.createElement("textarea");
input.value = raw;
document.body.appendChild(input);
input.select();
document.execCommand("copy");
document.body.removeChild(input);
btn.innerHTML = t.copied;
setTimeout(function() { btn.innerHTML = oldHtml; }, 2000);
};
if (navigator.clipboard && navigator.clipboard.writeText) {
navigator.clipboard.writeText(raw).then(function() {
btn.innerHTML = t.copied;
setTimeout(function() { btn.innerHTML = oldHtml; }, 2000);
}).catch(fallback);
} else {
fallback();
}
}
};
var impactLoaded = false;
var pubsLoaded = false;
function checkAllDone() {
if (!impactLoaded && typeof window.WXZ_IMPACT !== 'undefined') {
impactLoaded = true;
renderImpactUI();
}
if (!pubsLoaded && typeof window.WXZ_PUBLICATIONS !== 'undefined') {
pubsLoaded = true;
WxzPubApp.init();
}
return impactLoaded && pubsLoaded;
}
function fetchGiteeFile(fileName, branch, onFail) {
var apiUrl = 'https://gitee.com/api/v5/repos/zxwiii/wxz-publications/contents/' + fileName + '?ref=' + branch + '&t=' + Date.now();
fetch(apiUrl)
.then(function(res) { return res.ok ? res.json() : Promise.reject(); })
.then(function(data) {
if (data && data.content) {
var binStr = atob(data.content.replace(/\s/g, ''));
var bytes = new Uint8Array(binStr.length);
for (var i = 0; i < binStr.length; i++) bytes[i] = binStr.charCodeAt(i);
var code = new TextDecoder('utf-8').decode(bytes);
var s = document.createElement('script');
s.text = code;
document.head.appendChild(s);
checkAllDone();
} else if (onFail) {
onFail();
}
})
.catch(function() { if (onFail) onFail(); });
}
function loadSingleResource(varName, fileName, ver) {
if (typeof window[varName] !== 'undefined') {
checkAllDone();
return;
}
var ts = '?t=' + Date.now();
var urls = (window.location.protocol === 'file:') ? [
'./' + fileName,
'https://fastly.jsdelivr.net/gh/zxwiii/wxz-publications' + ver + '/' + fileName + ts,
'https://cdn.jsdelivr.net/gh/zxwiii/wxz-publications' + ver + '/' + fileName + ts
] : [
'https://fastly.jsdelivr.net/gh/zxwiii/wxz-publications' + ver + '/' + fileName + ts,
'https://cdn.jsdelivr.net/gh/zxwiii/wxz-publications' + ver + '/' + fileName + ts,
'https://wxz.group/' + fileName + ts,
'./' + fileName
];
function tryIdx(idx) {
if (typeof window[varName] !== 'undefined' || idx >= urls.length) {
checkAllDone();
return;
}
var s = document.createElement('script');
s.src = urls[idx];
s.async = true;
s.onload = function() {
if (!checkAllDone() && typeof window[varName] === 'undefined') {
tryIdx(idx + 1);
}
};
s.onerror = function() {
tryIdx(idx + 1);
};
document.head.appendChild(s);
}
tryIdx(0);
setTimeout(function() {
if (typeof window[varName] === 'undefined') {
fetchGiteeFile(fileName, 'main', function() {
if (typeof window[varName] === 'undefined') {
fetchGiteeFile(fileName, 'master', null);
}
});
}
}, 1500);
}
function startUnifiedLoading(sha) {
var ver = sha ? ('@' + sha) : '@main';
loadSingleResource('WXZ_IMPACT', 'impact_data.js', ver);
loadSingleResource('WXZ_PUBLICATIONS', 'publications_data.js', ver);
}
if (window.location.protocol === 'file:') {
startUnifiedLoading(null);
} else {
var shaResolved = false;
var abortCtrl = typeof AbortController !== 'undefined' ? new AbortController() : null;
var timer = setTimeout(function() {
if (!shaResolved) {
shaResolved = true;
if (abortCtrl) abortCtrl.abort();
startUnifiedLoading(null);
}
}, 1000);
fetch('https://api.github.com/repos/zxwiii/wxz-publications/commits/main', { signal: abortCtrl ? abortCtrl.signal : null })
.then(function(res) { return res.ok ? res.json() : Promise.reject(); })
.then(function(data) {
if (!shaResolved) {
shaResolved = true;
clearTimeout(timer);
var commitSha = (data && data.sha) ? data.sha.substring(0, 10) : null;
startUnifiedLoading(commitSha);
}
})
.catch(function() {
if (!shaResolved) {
shaResolved = true;
clearTimeout(timer);
startUnifiedLoading(null);
}
});
}
})();
</script>

