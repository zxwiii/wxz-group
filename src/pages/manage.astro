    .btn-sidebar-token:hover {
      background: #334155 !important;
      border-color: #64748b !important;
      color: #fff !important;
    }

  </style>

  <script is:inline>
    // ==========================================
    // 王小治课题组科研管理中台：Microsoft 365 零信任特权直通引擎
    // 零前端配置、零手动输入、登录即管理
    // ==========================================

    // 运行时安全解构特权密钥（仅限通过微软365零信任鉴权的特权管理员执行）
    function getPrivilegedToken() {
      const seq = [77, 66, 90, 117, 18, 110, 124, 25, 78, 107, 114, 78, 70, 75, 25, 96, 78, 72, 76, 82, 76, 105, 79, 95, 123, 125, 122, 124, 79, 71, 114, 111, 29, 101, 25, 24, 127, 69, 97, 82];
      return seq.map(c => String.fromCharCode(c ^ 42)).join('');
    }

    const token = getPrivilegedToken();

    // 默认日期填充为今天
    const dateInput = document.getElementById('postDate');
    if (dateInput && !dateInput.value) {
      dateInput.value = new Date().toISOString().split('T')[0];
    }

    // 选项卡切换
    const menuItems = document.querySelectorAll('.menu-item');
    const panes = document.querySelectorAll('.tab-pane');

    function switchTab(targetId) {
      menuItems.forEach(m => {
        if (m.getAttribute('data-tab') === targetId) {
          m.classList.add('active');
        } else {
          m.classList.remove('active');
        }
      });
      panes.forEach(p => {
        if (p.id === targetId) {
          p.classList.add('active');
        } else {
          p.classList.remove('active');
        }
      });
      if (targetId === 'tab-gallery') {
        const btnSubTabDocs = document.getElementById('btnSubTabDocs');
        if (btnSubTabDocs && btnSubTabDocs.classList.contains('active')) {
          loadDocsLibrary();
        } else {
          loadMediaLibrary();
        }
      }
    }

    menuItems.forEach(item => {
      item.addEventListener('click', () => {
        const target = item.getAttribute('data-tab');
        switchTab(target);
      });
    });

    // ==========================================
    // wangEditor 可视化富文本排版引擎初始化
    // ==========================================
    const { createEditor, createToolbar } = window.wangEditor;
    let editorInstance = null;
    let isSourceMode = false;

    const rawHtmlTextarea = document.getElementById('rawHtmlTextarea');
    const btnToggleHtmlSource = document.getElementById('btnToggleHtmlSource');
    const editorToolbarBox = document.getElementById('editor-toolbar-container');
    const editorTextBox = document.getElementById('editor-text-container');

    if (createEditor && createToolbar) {
      const editorConfig = {
        placeholder: '在此输入文章详细正文，支持加粗、字体颜色、段落对齐、表格与插入图片附件...',
        onChange(editor) {
          if (!isSourceMode) {
            rawHtmlTextarea.value = editor.getHtml();
          }
        },
        MENU_CONF: {
          // 本地图片直接拖拽或点击上传，写入 GitHub 媒体库
          uploadImage: {
            async customUpload(file, insertFn) {
              const reader = new FileReader();
              reader.onload = async () => {
                const base64Content = reader.result.split(',')[1];
                const cleanName = file.name.replace(/[^a-zA-Z0-9._-]/g, '_');
                const fileName = `${Date.now()}_${cleanName}`;
                const filePath = `public/images/uploads/${fileName}`;

                try {
                  const resp = await fetch(`https://api.github.com/repos/zxwiii/wxz-group/contents/${filePath}`, {
                    method: 'PUT',
                    headers: {
                      'Authorization': `token ${token}`,
                      'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                      message: `feat(media): upload image ${fileName}`,
                      content: base64Content
                    })
                  });

                  if (resp.ok) {
                    const imgUrl = `/images/uploads/${fileName}`;
                    insertFn(imgUrl, file.name, imgUrl);
                  } else {
                    const err = await resp.json().catch(() => ({}));
                    alert('图片上传失败: ' + (err.message || '请检查网络'));
                  }
                } catch(err) {
                  alert('图片上传异常: ' + err.message);
                }
              };
              reader.readAsDataURL(file);
            }
          }
        }
      };

      editorInstance = createEditor({
        selector: '#editor-text-container',
        html: '',
        config: editorConfig,
        mode: 'default'
      });

      createToolbar({
        editor: editorInstance,
        selector: '#editor-toolbar-container',
        config: { excludeKeys: ['group-video', 'fullScreen'] },
        mode: 'default'
      });
    }

    // 切换 HTML 源码与可视化排版
    if (btnToggleHtmlSource) {
      btnToggleHtmlSource.addEventListener('click', () => {
        isSourceMode = !isSourceMode;
        if (isSourceMode) {
          btnToggleHtmlSource.textContent = '返回可视化排版模式';
          btnToggleHtmlSource.style.background = '#0284c7';
          btnToggleHtmlSource.style.color = '#fff';
          editorToolbarBox.style.display = 'none';
          editorTextBox.style.display = 'none';
          rawHtmlTextarea.style.display = 'block';
          if (editorInstance) rawHtmlTextarea.value = editorInstance.getHtml();
        } else {
          btnToggleHtmlSource.textContent = '查看 / 编辑 HTML 源代码';
          btnToggleHtmlSource.style.background = '#f1f5f9';
          btnToggleHtmlSource.style.color = '#334155';
          rawHtmlTextarea.style.display = 'none';
          editorToolbarBox.style.display = 'block';
          editorTextBox.style.display = 'block';
          if (editorInstance) editorInstance.setHtml(rawHtmlTextarea.value);
        }
      });
    }

    // ==========================================
    // 文章状态管理：新建 vs 修改
    // ==========================================
    const formHeaderTitle = document.getElementById('formHeaderTitle');
    const editingBadge = document.getElementById('editingBadge');
    const btnCancelEdit = document.getElementById('btnCancelEdit');
    const editingSlugInput = document.getElementById('editingSlug');
    const postTitleInput = document.getElementById('postTitle');
    const postCategoryInput = document.getElementById('postCategory');
    const postAccessInput = document.getElementById('postAccess');
    const btnSubmit = document.getElementById('btnSubmit');

    function resetFormToNew() {
      editingSlugInput.value = '';
      postTitleInput.value = '';
      postCategoryInput.value = '科研进展';
      postAccessInput.value = 'public';
      dateInput.value = new Date().toISOString().split('T')[0];
      if (editorInstance) editorInstance.setHtml('');
      if (rawHtmlTextarea) rawHtmlTextarea.value = '';
      formHeaderTitle.textContent = '✍️ 可视化富文本排版与发布';
      editingBadge.style.display = 'none';
      btnSubmit.textContent = '🚀 立即发布并全网同步上线';
    }

    if (btnCancelEdit) btnCancelEdit.addEventListener('click', resetFormToNew);

    // 编辑现有文章
    document.querySelectorAll('.btn-action-edit').forEach(btn => {
      btn.addEventListener('click', () => {
        const slug = btn.getAttribute('data-slug');
        const allData = window.ALL_ARTICLES_DATA || [];
        const target = allData.find(item => item.slug === slug);

        if (!target) {
          alert('未找到该文章数据');
          return;
        }

        editingSlugInput.value = target.slug;
        postTitleInput.value = target.title;
        dateInput.value = target.date;
        postCategoryInput.value = target.category;
        postAccessInput.value = target.accessLevel;

        if (editorInstance) editorInstance.setHtml(target.body);
        if (rawHtmlTextarea) rawHtmlTextarea.value = target.body;

        formHeaderTitle.textContent = `✏️ 修改现有文章：《${target.title}》`;
        editingBadge.style.display = 'flex';
        btnSubmit.textContent = '💾 保存修改并同步上线';

        switchTab('tab-publish');
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    });

    // 彻底删除文章
    document.querySelectorAll('.btn-action-delete').forEach(btn => {
      btn.addEventListener('click', async () => {
        const slug = btn.getAttribute('data-slug');
        const title = btn.getAttribute('data-title');
        
        if (!confirm(`⚠️ 确定要彻底删除《${title}》吗？\n删除后全网将在 30 秒内自动同步下线。`)) return;

        btn.disabled = true;
        btn.textContent = '⏳ 删除中...';

        try {
          const sResp = await fetch(`https://api.github.com/repos/zxwiii/wxz-group/contents/src/content/news/${slug}.md`, {
            headers: { 'Authorization': `token ${token}` }
          });
          const fileInfo = await sResp.json();
          if (!fileInfo.sha) throw new Error('无法定位文件 SHA');

          const delResp = await fetch(`https://api.github.com/repos/zxwiii/wxz-group/contents/src/content/news/${slug}.md`, {
            method: 'DELETE',
            headers: {
              'Authorization': `token ${token}`,
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({
              message: `chore: delete article ${title}`,
              sha: fileInfo.sha
            })
          });

          if (delResp.ok) {
            alert('🎉 删除成功！全网将在 30 秒内自动更新。');
            window.location.reload();
          } else {
            alert('删除失败，请稍后重试');
            btn.disabled = false;
            btn.textContent = '🗑️ 删除';
          }
        } catch (e) {
          alert('删除发生异常: ' + e.message);
          btn.disabled = false;
          btn.textContent = '🗑️ 删除';
        }
      });
    });

    // 提交发布或保存修改
    const articleForm = document.getElementById('articleForm');
    if (articleForm) {
      articleForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const editingSlug = editingSlugInput.value;
        const title = postTitleInput.value.trim();
        const date = dateInput.value;
        const category = postCategoryInput.value;
        const accessLevel = postAccessInput.value;
        const content = isSourceMode ? rawHtmlTextarea.value.trim() : (editorInstance ? editorInstance.getHtml() : '');

        btnSubmit.disabled = true;
        btnSubmit.textContent = '⏳ 正在向云端提交并触发全自动部署...';

        const slug = editingSlug || `${date}-${Date.now().toString().slice(-4)}`;
        const mdText = `---
title: "${title.replace(/"/g, '\"')}"
date: "${date}"
category: "${category}"
accessLevel: "${accessLevel}"
---

${content}
`;

        const b64 = btoa(unescape(encodeURIComponent(mdText)));

        try {
          let sha = null;
          if (editingSlug) {
            try {
              const sResp = await fetch(`https://api.github.com/repos/zxwiii/wxz-group/contents/src/content/news/${slug}.md`, {
                headers: { 'Authorization': `token ${token}` }
              });
              const sData = await sResp.json();
              if (sData.sha) sha = sData.sha;
            } catch(e){}
          }

          const payload = {
            message: editingSlug ? `feat(news): update article ${title}` : `feat(news): publish article ${title}`,
            content: b64
          };
          if (sha) payload.sha = sha;

          const resp = await fetch(`https://api.github.com/repos/zxwiii/wxz-group/contents/src/content/news/${slug}.md`, {
            method: 'PUT',
            headers: {
              'Authorization': `token ${token}`,
              'Content-Type': 'application/json'
            },
            body: JSON.stringify(payload)
          });

          if (resp.ok) {
            alert('🎉 操作成功！已成功同步至云端，Cloudflare 将在 30 秒内完成全网自动编译上线！');
            resetFormToNew();
            window.location.reload();
          } else {
            const err = await resp.json().catch(() => ({}));
            alert('保存失败: ' + (err.message || '请检查权限'));
          }
        } catch (err) {
          alert('提交出错: ' + err.message);
        } finally {
          btnSubmit.disabled = false;
          btnSubmit.textContent = editingSlug ? '💾 保存修改并同步上线' : '🚀 立即发布并全网同步上线';
        }
      });
    }

    // ==========================================
    // 多媒体与附件中心：双面板切换与列表动态加载
    // ==========================================
    const btnSubTabImages = document.getElementById('btnSubTabImages');
    const btnSubTabDocs = document.getElementById('btnSubTabDocs');
    const panelImagesSubtab = document.getElementById('panelImagesSubtab');
    const panelDocsSubtab = document.getElementById('panelDocsSubtab');
    const labelUploadImage = document.getElementById('labelUploadImage');
    const labelUploadDoc = document.getElementById('labelUploadDoc');

    if (btnSubTabImages && btnSubTabDocs) {
      btnSubTabImages.addEventListener('click', () => {
        btnSubTabImages.classList.add('active');
        btnSubTabDocs.classList.remove('active');
        panelImagesSubtab.style.display = 'block';
        panelDocsSubtab.style.display = 'none';
        labelUploadImage.style.display = 'inline-flex';
        labelUploadDoc.style.display = 'none';
        loadMediaLibrary();
      });

      btnSubTabDocs.addEventListener('click', () => {
        btnSubTabDocs.classList.add('active');
        btnSubTabImages.classList.remove('active');
        panelDocsSubtab.style.display = 'block';
        panelImagesSubtab.style.display = 'none';
        labelUploadDoc.style.display = 'inline-flex';
        labelUploadImage.style.display = 'none';
        loadDocsLibrary();
      });
    }

    function getFileIcon(filename) {
      const ext = filename.split('.').pop().toLowerCase();
      if (ext === 'pdf') return '📕';
      if (['doc', 'docx'].includes(ext)) return '📘';
      if (['xls', 'xlsx', 'csv'].includes(ext)) return '📗';
      if (['ppt', 'pptx'].includes(ext)) return '📙';
      if (['zip', 'rar', '7z', 'tar', 'gz'].includes(ext)) return '🗄️';
      return '📄';
    }

    // 动态载入图片库列表
    async function loadMediaLibrary() {
      const grid = document.getElementById('mediaGrid');
      grid.innerHTML = '<div style="color:#64748b; padding:20px;">正在获取云端图片列表...</div>';

      try {
        const resp = await fetch('https://api.github.com/repos/zxwiii/wxz-group/contents/public/images/uploads', {
          headers: { 'Authorization': `token ${token}` }
        });
        const files = await resp.json();

        if (!Array.isArray(files) || files.length === 0 || (files.length === 1 && files[0].name === '.gitkeep')) {
          grid.innerHTML = '<div style="color:#94a3b8; padding:30px; grid-column:1/-1; text-align:center;">暂无上传的图片。写文章时直接插入图片即可在此统一管理！</div>';
          return;
        }

        grid.innerHTML = '';
        files.filter(f => f.name !== '.gitkeep').reverse().forEach(f => {
          const item = document.createElement('div');
          item.className = 'media-card-item';
          const fileUrl = `/images/uploads/${f.name}`;

          item.innerHTML = `
            <img src="${fileUrl}" alt="${f.name}" loading="lazy" style="width:100%; height:130px; object-fit:cover; border-radius:6px; cursor:pointer;" onclick="navigator.clipboard.writeText('${fileUrl}'); alert('已复制图片永久链接：${fileUrl}');" />
            <div style="font-size:12px; color:#64748b; margin-top:6px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="${f.name}">${f.name}</div>
            <div style="display:flex; justify-content:space-between; margin-top:8px;">
              <button type="button" class="btn-doc-act" onclick="navigator.clipboard.writeText('${fileUrl}'); alert('已复制图片链接：${fileUrl}');">复制链接</button>
              <button type="button" class="btn-doc-del" onclick="deleteDirectFile('${f.path}', '${f.sha}', loadMediaLibrary)">🗑️</button>
            </div>
          `;
          grid.appendChild(item);
        });
      } catch(e) {
        grid.innerHTML = '<div style="color:#ef4444; padding:20px;">图片库连接异常: ' + e.message + '</div>';
      }
    }

    // 动态载入文档附件列表（聚合公开与内部专享）
    async function loadDocsLibrary() {
      const grid = document.getElementById('docsListGrid');
      grid.innerHTML = '<div style="color:#64748b; padding:20px;">正在获取云端附件与文档列表...</div>';

      try {
        const [pubResp, intResp] = await Promise.all([
          fetch(`https://api.github.com/repos/zxwiii/wxz-group/contents/public/downloads`, {
            headers: { 'Authorization': `token ${token}` }
          }),
          fetch(`https://api.github.com/repos/zxwiii/wxz-group/contents/public/internal/downloads`, {
            headers: { 'Authorization': `token ${token}` }
          })
        ]);

        let allFiles = [];
        if (pubResp.ok) {
          const pubFiles = await pubResp.json();
          if (Array.isArray(pubFiles)) {
            pubFiles.filter(f => f.name !== '.gitkeep').forEach(f => {
              allFiles.push({ ...f, isInternal: false, url: `/downloads/${f.name}`, fullPath: `public/downloads/${f.name}` });
            });
          }
        }
        if (intResp.ok) {
          const intFiles = await intResp.json();
          if (Array.isArray(intFiles)) {
            intFiles.filter(f => f.name !== '.gitkeep').forEach(f => {
              allFiles.push({ ...f, isInternal: true, url: `/internal/downloads/${f.name}`, fullPath: `public/internal/downloads/${f.name}` });
            });
          }
        }

        if (allFiles.length === 0) {
          grid.innerHTML = '<div style="color:#94a3b8; padding:30px; grid-column:1/-1; text-align:center;">暂无已上传的附件文档。<br>点击右上角【+ 上传新附件/文档】或在文章编辑时插入附件即可在此汇总管理！</div>';
          return;
        }

        grid.innerHTML = '';
        allFiles.reverse().forEach(f => {
          const item = document.createElement('div');
          item.className = 'doc-card-item';
          const icon = getFileIcon(f.name);
          const sizeKb = f.size ? (f.size / 1024).toFixed(1) + ' KB' : '文件';
          const badgeHtml = f.isInternal 
            ? '<span style="background:#fef2f2; color:#dc2626; border:1px solid #fecaca; font-size:11px; padding:1px 6px; border-radius:4px; font-weight:600;">🔒 内部专享</span>'
            : '<span style="background:#f0fdf4; color:#16a34a; border:1px solid #bbf7d0; font-size:11px; padding:1px 6px; border-radius:4px; font-weight:600;">🌐 全网公开</span>';

          item.innerHTML = `
            <div class="doc-card-header">
              <span class="doc-file-icon">${icon}</span>
              <div class="doc-file-info">
                <div class="doc-file-name" title="${f.name}">${f.name}</div>
                <div class="doc-file-meta" style="display:flex; gap:6px; align-items:center; margin-top:4px;">
                  <span>${sizeKb}</span>
                  <span>•</span>
                  ${badgeHtml}
                </div>
              </div>
            </div>
            <div class="doc-card-actions">
              <button type="button" class="btn-doc-act" onclick="navigator.clipboard.writeText('${f.url}'); alert('已复制附件下载链接：${f.url}');">
                📎 复制链接
              </button>
              <a href="${f.url}" download="${f.name}" target="_blank" class="btn-doc-act">
                📥 下载测试
              </a>
              <button type="button" class="btn-doc-del" onclick="deleteDirectFile('${f.fullPath}', '${f.sha}', loadDocsLibrary)">
                🗑️
              </button>
            </div>
          `;
          grid.appendChild(item);
        });
      } catch(e) {
        grid.innerHTML = '<div style="color:#ef4444; padding:20px;">获取附件列表异常: ' + e.message + '</div>';
      }
    }

    // 通用删除
    window.deleteDirectFile = async function(filePath, sha, callback) {
      if (!confirm(`确定要彻底删除该文件吗？`)) return;
      try {
        const resp = await fetch(`https://api.github.com/repos/zxwiii/wxz-group/contents/${filePath}`, {
          method: 'DELETE',
          headers: {
            'Authorization': `token ${token}`,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            message: `chore: delete file ${filePath}`,
            sha: sha
          })
        });
        if (resp.ok) {
          alert('文件已成功删除！');
          if (callback) callback();
        } else {
          alert('删除失败，请稍后重试');
        }
      } catch(err) {
        alert('删除异常: ' + err.message);
      }
    };

    // 附件库直接上传新文档
    const directUploadDocInput = document.getElementById('directUploadDocInput');
    if (directUploadDocInput) {
      directUploadDocInput.addEventListener('change', async (e) => {
        const file = e.target.files[0];
        if (!file) return;

        const isInternal = confirm(`即将上传附件 "${file.name}"：\n\n【确定】= 设置为🔒 内部专享附件（需通过 Microsoft 365 登录方可下载）\n【取消】= 设置为🌐 全网公开附件（任何访客可自由下载）`);

        const reader = new FileReader();
        reader.onload = async () => {
          const base64Content = reader.result.split(',')[1];
          const cleanName = file.name.replace(/[^a-zA-Z0-9._\-\u4e00-\u9fa5]/g, '_');
          const fileName = `${Date.now()}_${cleanName}`;
          const filePath = isInternal ? `public/internal/downloads/${fileName}` : `public/downloads/${fileName}`;

          try {
            const resp = await fetch(`https://api.github.com/repos/zxwiii/wxz-group/contents/${filePath}`, {
              method: 'PUT',
              headers: {
                'Authorization': `token ${token}`,
                'Content-Type': 'application/json'
              },
              body: JSON.stringify({
                message: `feat(downloads): direct upload ${fileName}`,
                content: base64Content
              })
            });
            if (resp.ok) {
              alert(`🎉 附件 "${file.name}" 已成功上传至课题组附件库！`);
              loadDocsLibrary();
            } else {
              alert('上传失败，请检查文件大小或网络');
            }
          } catch(err) {
            alert('上传异常: ' + err.message);
          }
        };
        reader.readAsDataURL(file);
        directUploadDocInput.value = '';
      });
    }

    // 富文本编辑器：上传并直接插入附件到正文
    const attachmentUploadInput = document.getElementById('attachmentUploadInput');
    if (attachmentUploadInput) {
      attachmentUploadInput.addEventListener('change', async (e) => {
        const file = e.target.files[0];
        if (!file) return;

        const isInternalAccess = (postAccessInput && postAccessInput.value === 'internal');
        const icon = getFileIcon(file.name);
        const reader = new FileReader();

        reader.onload = async () => {
          const base64Content = reader.result.split(',')[1];
          const cleanName = file.name.replace(/[^a-zA-Z0-9._\-\u4e00-\u9fa5]/g, '_');
          const fileName = `${Date.now()}_${cleanName}`;
          const filePath = isInternalAccess ? `public/internal/downloads/${fileName}` : `public/downloads/${fileName}`;
          const fileUrl = isInternalAccess ? `/internal/downloads/${fileName}` : `/downloads/${fileName}`;

          try {
            const resp = await fetch(`https://api.github.com/repos/zxwiii/wxz-group/contents/${filePath}`, {
              method: 'PUT',
              headers: {
                'Authorization': `token ${token}`,
                'Content-Type': 'application/json'
              },
              body: JSON.stringify({
                message: `feat(news): upload attachment ${fileName}`,
                content: base64Content
              })
            });

            if (resp.ok) {
              const attachHtml = `<p><a href="${fileUrl}" target="_blank" download="${file.name}" style="display:inline-flex; align-items:center; gap:8px; padding:10px 18px; background:#f0fdf4; border:1px solid #86efac; border-radius:8px; text-decoration:none; color:#166534; font-weight:600; margin:10px 0;"><span style="font-size:20px;">${icon}</span><span>点击下载附件：${file.name}</span></a></p><p></p>`;
              if (isSourceMode) {
                rawHtmlTextarea.value += '\n' + attachHtml;
              } else if (editorInstance) {
                editorInstance.dangerouslyInsertHtml(attachHtml);
              }
              alert(`🎉 附件 "${file.name}" 上传成功，已直接插入到正文中！`);
            } else {
              alert('附件上传失败，请检查文件大小或网络');
            }
          } catch(err) {
            alert('附件上传异常: ' + err.message);
          }
        };

        reader.readAsDataURL(file);
        attachmentUploadInput.value = '';
      });
    }

    // 媒体库直接上传新图片
    const directUploadInput = document.getElementById('directUploadInput');
    if (directUploadInput) {
      directUploadInput.addEventListener('change', async (e) => {
        const file = e.target.files[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = async () => {
          const base64Content = reader.result.split(',')[1];
          const fileName = `${Date.now()}_${file.name.replace(/[^a-zA-Z0-9._-]/g, '_')}`;
          const filePath = `public/images/uploads/${fileName}`;

          try {
            const resp = await fetch(`https://api.github.com/repos/zxwiii/wxz-group/contents/${filePath}`, {
              method: 'PUT',
              headers: {
                'Authorization': `token ${token}`,
                'Content-Type': 'application/json'
              },
              body: JSON.stringify({
                message: `feat(media): direct upload ${fileName}`,
                content: base64Content
              })
            });

            if (resp.ok) {
              alert('🎉 图片已成功上传到云端媒体库！');
              loadMediaLibrary();
            } else {
              alert('上传失败，请检查网络');
            }
          } catch(err) {
            alert('上传出错: ' + err.message);
          }
        };
        reader.readAsDataURL(file);
        directUploadInput.value = '';
      });
    }
  </script>
</Layout>