  <script is:inline>
    // ==========================================
    // 常驻卡片式 GitHub Token 密钥交互逻辑 (全响应支持)
    // ==========================================
    window.openTokenConfig = function() {
      if (typeof switchTab === 'function') {
        switchTab('tab-overview');
      }
      const card = document.getElementById('tokenConfigCard');
      if (card) {
        card.scrollIntoView({ behavior: 'smooth' });
        card.style.boxShadow = '0 0 0 4px rgba(59, 130, 246, 0.5)';
        setTimeout(() => { card.style.boxShadow = ''; }, 2500);
      }
      const input = document.getElementById('cardInputGithubToken');
      if (input) {
        input.focus();
      }
    };

    window.clearCardToken = function() {
      const input = document.getElementById('cardInputGithubToken');
      if (input) {
        input.value = '';
        input.focus();
      }
    };

    window.testCardToken = async function() {
      const input = document.getElementById('cardInputGithubToken');
      const alertBox = document.getElementById('cardTokenAlert');
      const btn = document.getElementById('cardBtnTestToken');
      const tokenVal = input ? input.value.trim() : '';

      if (!tokenVal) {
        alert('请先在输入框中粘贴您的 GitHub Token（以 ghp_ 开头）！');
        if (input) input.focus();
        return;
      }

      if (btn) {
        btn.disabled = true;
        btn.textContent = '⏳ 测试中...';
      }
      if (alertBox) {
        alertBox.style.display = 'block';
        alertBox.style.background = '#eff6ff';
        alertBox.style.border = '1px solid #bfdbfe';
        alertBox.style.color = '#1d4ed8';
        alertBox.innerHTML = '正在向 GitHub 官方服务器验证密钥有效性，请稍候...';
      }

      try {
        const resp = await fetch('https://api.github.com/repos/zxwiii/wxz-group', {
          headers: { 'Authorization': `token ${tokenVal}` }
        });
        if (btn) {
          btn.disabled = false;
          btn.textContent = '🔍 测试连接';
        }

        if (resp.ok) {
          const repo = await resp.json();
          if (alertBox) {
            alertBox.style.background = '#f0fdf4';
            alertBox.style.border = '1px solid #bbf7d0';
            alertBox.style.color = '#15803d';
            alertBox.innerHTML = `<strong>✅ 校验通过！</strong> 成功连接到课题组仓库 <code>${repo.full_name}</code>，具备完整文章发布与附件上传权限。请点击右侧【保存并立即生效】！`;
          }
        } else if (resp.status === 401) {
          if (alertBox) {
            alertBox.style.background = '#fef2f2';
            alertBox.style.border = '1px solid #fecaca';
            alertBox.style.color = '#b91c1c';
            alertBox.innerHTML = `<strong>❌ 校验失败 (401 Bad credentials)：</strong> 该 Token 无效或已过期，请重新在 GitHub 生成新的 Token 粘贴！`;
          }
        } else {
          if (alertBox) {
            alertBox.style.background = '#fef2f2';
            alertBox.style.border = '1px solid #fecaca';
            alertBox.style.color = '#b91c1c';
            alertBox.innerHTML = `<strong>❌ 校验未通过：</strong> HTTP ${resp.status}，请确认是否勾选了 repo 读写权限。`;
          }
        }
      } catch (err) {
        if (btn) {
          btn.disabled = false;
          btn.textContent = '🔍 测试连接';
        }
        if (alertBox) {
          alertBox.style.background = '#fef2f2';
          alertBox.style.border = '1px solid #fecaca';
          alertBox.style.color = '#b91c1c';
          alertBox.innerHTML = `<strong>❌ 网络连接异常：</strong> ${err.message}`;
        }
      }
    };

    window.saveCardToken = async function() {
      const input = document.getElementById('cardInputGithubToken');
      const alertBox = document.getElementById('cardTokenAlert');
      const btn = document.getElementById('cardBtnSaveToken');
      const tokenVal = input ? input.value.trim() : '';

      if (!tokenVal) {
        alert('请先输入有效的 GitHub Token！');
        if (input) input.focus();
        return;
      }

      if (btn) {
        btn.disabled = true;
        btn.textContent = '⏳ 正在保存...';
      }

      try {
        const resp = await fetch('https://api.github.com/repos/zxwiii/wxz-group', {
          headers: { 'Authorization': `token ${tokenVal}` }
        });
        if (btn) {
          btn.disabled = false;
          btn.textContent = '💾 保存并立即生效';
        }

        if (resp.ok) {
          localStorage.setItem('wxz_token', tokenVal);
          localStorage.setItem('decap-cms-user', JSON.stringify({ backendName: 'github', token: tokenVal }));
          if (alertBox) {
            alertBox.style.display = 'block';
            alertBox.style.background = '#f0fdf4';
            alertBox.style.border = '1px solid #bbf7d0';
            alertBox.style.color = '#15803d';
            alertBox.innerHTML = '<strong>🎉 保存成功！</strong> 密钥已安全锁存在您当前的浏览器本地中。全部云端发布功能已恢复！';
          }
          alert('🎉 GitHub 访问密钥已成功保存并立即生效！文章发布、图片与附件上传已全部恢复。');
          window.location.reload();
        } else {
          if (alertBox) {
            alertBox.style.display = 'block';
            alertBox.style.background = '#fef2f2';
            alertBox.style.border = '1px solid #fecaca';
            alertBox.style.color = '#b91c1c';
            alertBox.innerHTML = '<strong>❌ 无法保存：</strong> Token 校验失败 (HTTP ' + resp.status + ')，请重新复制粘贴有效 Token！';
          }
          alert('无法保存：Token 校验未通过，请检查是否完整复制！');
        }
      } catch (err) {
        if (btn) {
          btn.disabled = false;
          btn.textContent = '💾 保存并立即生效';
        }
        alert('保存异常: ' + err.message);
      }
    };

    // 页面载入时自动回显与状态同步
    function syncCardTokenOnLoad() {
