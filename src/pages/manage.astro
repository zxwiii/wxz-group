  <script is:inline>
    // 默认日期填充为今天
    const dateInput = document.getElementById('postDate');
    if (dateInput) dateInput.value = new Date().toISOString().split('T')[0];

    // 选项卡切换
    const menuItems = document.querySelectorAll('.menu-item');
    const panes = document.querySelectorAll('.tab-pane');

    menuItems.forEach(item => {
      item.addEventListener('click', () => {
        menuItems.forEach(m => m.classList.remove('active'));
        panes.forEach(p => p.classList.remove('active'));

        item.classList.add('active');
        const targetId = item.getAttribute('data-tab');
        const targetPane = document.getElementById(targetId);
        if (targetPane) targetPane.classList.add('active');
      });
    });

    // 列表搜索过滤
    const filterInput = document.getElementById('filterInput');
    if (filterInput) {
      filterInput.addEventListener('input', (e) => {
        const q = (e.target.value || '').trim().toLowerCase();
        const rows = document.querySelectorAll('#articleTableBody tr');
        rows.forEach(r => {
          const t = r.getAttribute('data-title') || '';
          r.style.display = (!q || t.includes(q)) ? '' : 'none';
        });
      });
    }

    // 发布新文章至 GitHub
    const articleForm = document.getElementById('articleForm');
    if (articleForm) {
      articleForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const title = document.getElementById('postTitle').value.trim();
        const date = document.getElementById('postDate').value;
        const category = document.getElementById('postCategory').value;
        const accessLevel = document.getElementById('postAccess').value;
        const content = document.getElementById('postContent').value.trim();

        let token = localStorage.getItem('wxz_token') || localStorage.getItem('decap-cms-user');
        if (token && typeof token === 'string' && token.startsWith('{')) {
          try { token = JSON.parse(token).token; } catch(e){}
        }

        const btn = document.getElementById('btnSubmit');
        btn.disabled = true;
        btn.textContent = '⏳ 正在向云端提交并触发全自动部署...';

        const slug = `${date}-${Date.now().toString().slice(-4)}`;
        const mdText = `---
title: "${title.replace(/"/g, '\\"')}"
date: "${date}"
category: "${category}"
accessLevel: "${accessLevel}"
---

${content}
`;

        const b64 = btoa(unescape(encodeURIComponent(mdText)));

        try {
          const resp = await fetch(`https://api.github.com/repos/zxwiii/wxz-group/contents/src/content/news/${slug}.md`, {
            method: 'PUT',
            headers: {
              'Authorization': `token ${token}`,
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({
              message: `feat(news): publish article ${title}`,
              content: b64
            })
          });

          if (resp.ok) {
            alert('发布成功！Cloudflare 将在 30 秒内完成全网自动编译上线！');
            articleForm.reset();
            document.getElementById('postDate').value = new Date().toISOString().split('T')[0];
            window.location.reload();
          } else {
            const err = await resp.json();
            alert('发布失败: ' + (err.message || '网络或权限异常'));
          }
        } catch (err) {
          alert('提交出错: ' + err.message);
        } finally {
          btn.disabled = false;
          btn.textContent = '🚀 立即发布并全网同步上线';
        }
      });
    }
  </script>
</Layout>
