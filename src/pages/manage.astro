    // ==========================================
    const tokenModal = document.getElementById('tokenModal');
    const btnSidebarToken = document.getElementById('btnSidebarToken');
    const btnCloseTokenModal = document.getElementById('btnCloseTokenModal');
    const inputGithubToken = document.getElementById('inputGithubToken');
    const btnToggleTokenVisible = document.getElementById('btnToggleTokenVisible');
    const btnTestToken = document.getElementById('btnTestToken');
    const btnSaveToken = document.getElementById('btnSaveToken');
    const tokenVerifyAlert = document.getElementById('tokenVerifyAlert');
    const sidebarTokenDot = document.getElementById('sidebarTokenDot');
    const sidebarTokenText = document.getElementById('sidebarTokenText');

    function openTokenModal(warnMsg = '') {
      const currentToken = getAdminToken();
      if (inputGithubToken) {
        inputGithubToken.value = currentToken || '';
      }
      if (tokenVerifyAlert) {
        if (warnMsg) {
          tokenVerifyAlert.style.display = 'block';
          tokenVerifyAlert.style.background = '#fef2f2';
          tokenVerifyAlert.style.border = '1px solid #fecaca';
          tokenVerifyAlert.style.color = '#b91c1c';
          tokenVerifyAlert.innerHTML = `<strong>⚠️ 鉴权提示：</strong>${warnMsg}`;
        } else {
          tokenVerifyAlert.style.display = 'none';
        }
      }
      if (tokenModal) tokenModal.style.display = 'flex';
    }

    function closeTokenModal() {
      if (tokenModal) tokenModal.style.display = 'none';
    }

    if (btnSidebarToken) btnSidebarToken.addEventListener('click', () => openTokenModal());
    if (btnCloseTokenModal) btnCloseTokenModal.addEventListener('click', () => closeTokenModal());
    if (tokenModal) {
      tokenModal.addEventListener('click', (e) => {
        if (e.target === tokenModal) closeTokenModal();
      });
    }

    if (btnToggleTokenVisible) {
      btnToggleTokenVisible.addEventListener('click', () => {
        if (inputGithubToken.type === 'password') {
          inputGithubToken.type = 'text';
          btnToggleTokenVisible.textContent = '🔒';
        } else {
          inputGithubToken.type = 'password';
          btnToggleTokenVisible.textContent = '👁️';
        }
      });
    }

    async function verifyToken(t) {
      if (!t) return { ok: false, msg: '请输入有效 Token' };
      try {
        const resp = await fetch('https://api.github.com/repos/zxwiii/wxz-group', {
          headers: { 'Authorization': `token ${t}` }
        });
        if (resp.ok) {
          const repo = await resp.json();
          const perm = repo.permissions ? (repo.permissions.push ? '具备写入/推送权限' : '仅只读权限') : '权限已就绪';
          return { ok: true, msg: `连接正常！已成功连接到仓库 ${repo.full_name} (${perm})` };
        } else if (resp.status === 401) {
          return { ok: false, msg: 'Token 无效或已过期 (401 Bad credentials)，请重新生成！' };
        } else if (resp.status === 404) {
          return { ok: false, msg: 'Token 权限不足，无法访问该仓库，请确保勾选了 repo 权限！' };
        } else {
          return { ok: false, msg: `GitHub 响应异常 (HTTP ${resp.status})` };
        }
      } catch (err) {
        return { ok: false, msg: '网络连接失败: ' + err.message };
      }
    }

    function updateSidebarTokenStatus() {
      const t = getAdminToken();
      if (!sidebarTokenDot || !sidebarTokenText) return;
      if (t && t.length > 10) {
        sidebarTokenDot.style.background = '#22c55e';
        sidebarTokenText.textContent = 'GitHub 密钥: 正常';
      } else {
        sidebarTokenDot.style.background = '#ef4444';
        sidebarTokenText.textContent = 'GitHub 密钥: 未设置';
      }
    }

    if (btnTestToken) {
      btnTestToken.addEventListener('click', async () => {
        const t = inputGithubToken.value.trim();
        btnTestToken.disabled = true;
        btnTestToken.textContent = '⏳ 测试中...';
        const res = await verifyToken(t);
        btnTestToken.disabled = false;
        btnTestToken.textContent = '🔍 测试连接有效性';

        tokenVerifyAlert.style.display = 'block';
        if (res.ok) {
          tokenVerifyAlert.style.background = '#f0fdf4';
          tokenVerifyAlert.style.border = '1px solid #bbf7d0';
          tokenVerifyAlert.style.color = '#15803d';
          tokenVerifyAlert.innerHTML = `<strong>✅ 校验通过：</strong>${res.msg}`;
        } else {
          tokenVerifyAlert.style.background = '#fef2f2';
          tokenVerifyAlert.style.border = '1px solid #fecaca';
          tokenVerifyAlert.style.color = '#b91c1c';
          tokenVerifyAlert.innerHTML = `<strong>❌ 校验失败：</strong>${res.msg}`;
        }
      });
    }

    if (btnSaveToken) {
      btnSaveToken.addEventListener('click', async () => {
        const t = inputGithubToken.value.trim();
        if (!t) {
          alert('请先输入有效的 GitHub Token');
          return;
        }
        btnSaveToken.disabled = true;
        btnSaveToken.textContent = '⏳ 正在保存...';
        const res = await verifyToken(t);
        if (res.ok) {
          localStorage.setItem('wxz_token', t);
          localStorage.setItem('decap-cms-user', JSON.stringify({ backendName: 'github', token: t }));
          updateSidebarTokenStatus();
          alert('🎉 GitHub 访问密钥已成功更新并保存！全部云端功能已恢复正常。');
          closeTokenModal();
          window.location.reload();
        } else {
          btnSaveToken.disabled = false;
          btnSaveToken.textContent = '💾 保存并立即生效';
          tokenVerifyAlert.style.display = 'block';
          tokenVerifyAlert.style.background = '#fef2f2';
          tokenVerifyAlert.style.border = '1px solid #fecaca';
          tokenVerifyAlert.style.color = '#b91c1c';
          tokenVerifyAlert.innerHTML = `<strong>❌ 无法保存：</strong>${res.msg} 请检查后重试！`;
        }
      });
    }

    // 全局 API 错误拦截助手
    window.handleGitHubApiError = function(errData, status) {
      const msg = (errData && errData.message) ? errData.message : '';
      if (status === 401 || msg.includes('Bad credentials')) {
        openTokenModal('当前保存失败是因为 GitHub 访问密钥已失效 (Bad credentials)。请点击下方链接生成新 Token 并粘贴保存！');
        return true;
      }
      return false;
    };

    updateSidebarTokenStatus();

    // 凭据读取
    function getAdminToken() {
      let t = localStorage.getItem('wxz_token') || localStorage.getItem('decap-cms-user');
      if (t && typeof t === 'string' && t.startsWith('{')) {
        try { t = JSON.parse(t).token; } catch(e){}
      }
      return t || '';
    }

    const token = getAdminToken();

    // 默认日期填充为今天
    const dateInput = document.getElementById('postDate');
    if (dateInput && !dateInput.value) {
      dateInput.value = new Date().toISOString().split('T')[0];
    }

    // 选项卡切换
    const menuItems = document.querySelectorAll('.menu-item');
    const panes = document.querySelectorAll('.tab-pane');

    function switchTab(targetId) {
      menuItems.forEach(m => {
        if (m.getAttribute('data-tab') === targetId) {
          m.classList.add('active');
        } else {
          m.classList.remove('active');
        }
      });
      panes.forEach(p => {
        if (p.id === targetId) {
          p.classList.add('active');
        } else {
          p.classList.remove('active');
        }
      });
      if (targetId === 'tab-gallery') {
        loadMediaLibrary();
      }
    }

    menuItems.forEach(item => {
      item.addEventListener('click', () => {
        switchTab(item.getAttribute('data-tab'));
      });
    });

    // ==========================================
    // 核心模块：初始化 wangEditor 可视化富文本编辑器
    // ==========================================
    let editorInstance = null;
    let isSourceMode = false;
    const rawHtmlTextarea = document.getElementById('rawHtmlTextarea');
    const editorTextContainer = document.getElementById('editor-text-container');
    const btnToggleHtmlSource = document.getElementById('btnToggleHtmlSource');

    function initWangEditor() {
      if (typeof window.wangEditor === 'undefined') return;
      const { createEditor, createToolbar } = window.wangEditor;

      // 编辑器配置
      const editorConfig = {
        placeholder: '在此像在 Word 中一样打字输入正文内容...\n可以直接复制微信公众号排版粘贴进来，支持加粗、居中、表格和图片！',
        onChange(editor) {
          if (!isSourceMode) {
            rawHtmlTextarea.value = editor.getHtml();
          }
        },
        MENU_CONF: {
          // 自定义图片上传处理，直接上传到 GitHub 仓库并插图
          uploadImage: {
            async customUpload(file, insertFn) {
              const t = getAdminToken();
              const reader = new FileReader();
              reader.onload = async () => {
                const base64Content = reader.result.split(',')[1];
                const cleanName = file.name.replace(/[^a-zA-Z0-9._-]/g, '_');
                const fileName = `${Date.now()}_${cleanName}`;
                const filePath = `public/images/uploads/${fileName}`;

                try {
                  const resp = await fetch(`https://api.github.com/repos/zxwiii/wxz-group/contents/${filePath}`, {
                    method: 'PUT',
                    headers: {
                      'Authorization': `token ${t}`,
                      'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                      message: `feat(media): upload image ${fileName}`,
                      content: base64Content
                    })
                  });

                  if (resp.ok) {
                    const imgUrl = `/images/uploads/${fileName}`;
                    // 直接插入富文本编辑器正文！用户眼睛直接看得到图片！
                    insertFn(imgUrl, file.name, imgUrl);
                  } else {
                    const errData = await resp.json().catch(() => ({})); if (!handleGitHubApiError(errData, resp.status)) { alert('图片上传失败: ' + (errData.message || '请检查网络或管理员 Token')); }
                  }
                } catch(err) {
                  alert('图片上传出错: ' + err.message);
                }
              };
              reader.readAsDataURL(file);
            }
          }
        }
      };

      editorInstance = createEditor({
        selector: '#editor-text-container',
        html: '',
        config: editorConfig,
        mode: 'default'
      });

      // 工具栏配置
      createToolbar({
        editor: editorInstance,
        selector: '#editor-toolbar-container',
        config: {
          toolbarKeys: [
            'headerSelect', 'fontSize', '|',
            'bold', 'italic', 'underline', 'color', 'bgColor', '|',
            'justifyLeft', 'justifyCenter', 'justifyRight', '|',
            'bulletedList', 'numberedList', 'blockquote', '|',
            'insertTable', 'insertLink', 'uploadImage', 'divider', '|',
            'undo', 'redo'
          ]
        },
        mode: 'default'
      });
    }

    if (document.readyState === 'complete') {
      initWangEditor();
    } else {
      window.addEventListener('load', initWangEditor);
    }

    // 切换查看 HTML 源代码与所见即所得排版
    if (btnToggleHtmlSource) {
      btnToggleHtmlSource.addEventListener('click', () => {
        isSourceMode = !isSourceMode;
        if (isSourceMode) {
          btnToggleHtmlSource.textContent = '📝 返回纯打字可视化排版模式';
          rawHtmlTextarea.value = editorInstance.getHtml();
          editorTextContainer.style.display = 'none';
          document.getElementById('editor-toolbar-container').style.display = 'none';
          rawHtmlTextarea.style.display = 'block';
        } else {
          btnToggleHtmlSource.textContent = '查看 / 编辑 HTML 源代码';
          editorInstance.setHtml(rawHtmlTextarea.value);
          rawHtmlTextarea.style.display = 'none';
          document.getElementById('editor-toolbar-container').style.display = 'block';
          editorTextContainer.style.display = 'block';
        }
      });
