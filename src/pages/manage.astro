---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allNews = await getCollection('news');

function getSafeTime(d: any) {
  if (!d) return 0;
  try {
    const t = new Date(d).getTime();
    return isNaN(t) ? 0 : t;
  } catch (e) {
    return 0;
  }
}

function formatSafeDate(d: any) {
  if (!d) return '2024-01-01';
  try {
    const dateObj = new Date(d);
    if (isNaN(dateObj.getTime())) return String(d).slice(0, 10);
    return dateObj.toISOString().split('T')[0];
  } catch (e) {
    return '2024-01-01';
  }
}

allNews.sort((a, b) => getSafeTime(b.data.date) - getSafeTime(a.data.date));

// 将全部文章结构化导出供前端富文本编辑使用
const newsPayload = allNews.map(item => ({
  slug: item.slug,
  title: item.data.title || '',
  date: formatSafeDate(item.data.date),
  category: item.data.category || '科研进展',
  accessLevel: item.data.accessLevel || 'public',
  body: item.body || ''
}));
