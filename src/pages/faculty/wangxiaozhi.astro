---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="王小治教授" activeNav="members">
  <div class="profile-hero-banner">
    <div class="banner-inner">
      <div class="breadcrumb-nav">
        <a href="/">首页</a>
        <span class="sep">/</span>
        <a href="/members">团队成员</a>
        <span class="sep">/</span>
        <span class="current">王小治 教授</span>
      </div>
      <h1 class="hero-title">王小治 教授</h1>
      <p class="hero-subtitle">扬州大学环境科学与工程学院院长 · 一级学科带头人 · 课题组负责人 (PI)</p>
    </div>
  </div>

  <main class="profile-content-wrap">
    <!-- 个人名片与核心指标卡片 -->
    <section class="profile-card-main">
      <div class="profile-avatar-wrap">
        <img 
          src="/images/members/wangxiaozhi.jpg" 
          alt="王小治 教授" 
          onerror="this.src='/images/members/default_avatar.jpg'"
        />
        <div class="avatar-tag">课题组负责人 / PI</div>
      </div>

      <div class="profile-details">
        <div class="profile-header-row">
          <div class="profile-name-area">
            <h2 class="person-name">王小治 <span class="pinyin">Prof. Xiaozhi Wang</span></h2>
            <div class="title-tags">
              <span class="pill-primary">教授 · 博士生导师</span>
              <span class="pill-secondary">环境科学与工程学院院长</span>
              <span class="pill-accent">农业资源与环境学科带头人</span>
            </div>
          </div>
        </div>

        <!-- 四大核心学术影响力指标 -->
        <div class="metrics-grid">
          <div class="metric-card">
            <div class="metric-num">200<span class="plus">+</span></div>
            <div class="metric-label">高水平学术论文</div>
            <div class="metric-hint">Angew.、ES&T、WR 等顶刊</div>
          </div>
          <div class="metric-card">
            <div class="metric-num">7000<span class="plus">+</span></div>
            <div class="metric-label">论文总引用次数</div>
            <div class="metric-hint">Clarivate WoS 核心合集</div>
          </div>
          <div class="metric-card">
            <div class="metric-num">40<span class="plus">+</span></div>
            <div class="metric-label">学术 h-Index</div>
            <div class="metric-hint">国际学术影响力广泛</div>
          </div>
          <div class="metric-card">
            <div class="metric-num">50<span class="plus">+</span></div>
            <div class="metric-label">国家专利</div>
            <div class="metric-hint">涵盖修复材料与固碳技术</div>
          </div>
        </div>

        <!-- 联络方式与办公地点 -->
        <div class="contact-info-strip">
          <div class="contact-entry">
            <span class="icon">✉️</span>
            <span class="label">电子邮箱：</span>
            <a href="mailto:xzwang@yzu.edu.cn" class="link-val">xzwang@yzu.edu.cn</a>
          </div>
          <div class="contact-entry">
            <span class="icon">📍</span>
            <span class="label">办公地点：</span>
            <span class="text-val">扬州大学扬子津校区学行楼</span>
          </div>
          <div class="contact-entry">
            <span class="icon">🏛️</span>
            <span class="label">工作单位：</span>
            <span class="text-val">扬州大学环境科学与工程学院</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 个人履历简介 -->
    <section class="profile-section-box">
      <div class="section-badge-title">
        <span class="badge-icon">📖</span>
        <h3>个人概况与学者简介</h3>
      </div>
      <div class="bio-prose">
        <p>
          王小治，工学博士，扬州大学环境科学与工程学院教授、博士生导师、院长，扬州大学环境科学与工程一级学科带头人、扬州大学环境科学研究所所长。毕业于<strong>中国科学院南京土壤研究所</strong>，曾先后三次赴<strong>德国吉森大学（Justus-Liebig-Universität Gießen）</strong>开展学术访问与国际科研合作。
        </p>
        <p>
          长期深耕于<strong>全球气候变化与土壤生物地球化学循环</strong>、<strong>固体废弃物处置及资源化</strong>、<strong>水土环境污染修复材料</strong>与<strong>先进催化环境功能材料</strong>等前沿研究。先后主持国家自然科学基金（4项）、国家重点研发计划课题等数十项国家级与省部级重大科研任务；以通讯作者在 <em>Environ. Sci. Technol. (ES&T)</em>、<em>Angewandte Chemie</em>、<em>Water Research</em>、<em>Advanced Science</em> 等国际顶尖学术期刊发表学术论文 200 余篇，WoS 引用超 7000 次，H指数 40+，申请及拥有国家专利 50 余项；以第一完成人等荣获<strong>江苏省科技进步三等奖 1 项</strong>，<strong>江苏省高等教育教学成果二等奖 2 次</strong>。
        </p>
      </div>
    </section>

    <!-- 1. 教育与工作经历 -->
    <section class="profile-section-box">
      <div class="section-badge-title">
        <span class="badge-icon">🎓</span>
        <h3>教育与工作履历</h3>
      </div>
      <div class="timeline-container">
        <!-- 教育背景 -->
        <div class="timeline-category">
          <div class="category-heading">
            <span class="cat-dot"></span>
            <h4>教育背景与海外访学</h4>
          </div>
          <div class="timeline-list">
            <div class="timeline-item">
              <div class="time-tag">2002.09 – 2005.06</div>
              <div class="time-content">
                <div class="item-title">中国科学院南京土壤研究所</div>
                <div class="item-desc">土壤学专业 · 工学博士学位</div>
              </div>
            </div>
            <div class="timeline-item">
              <div class="time-tag">2010.01 – 2011.01</div>
              <div class="time-content">
                <div class="item-title">德国吉森大学（Justus Liebig University Giessen）</div>
                <div class="item-desc">废物管理与环境研究所 · 访问学者</div>
              </div>
            </div>
            <div class="timeline-item">
              <div class="time-tag">2007.07 – 2007.09</div>
              <div class="time-content">
                <div class="item-title">德国吉森大学（Justus Liebig University Giessen）</div>
                <div class="item-desc">植物营养研究所 · 访问学者</div>
              </div>
            </div>
            <div class="timeline-item">
              <div class="time-tag">1998.02 – 1998.11</div>
              <div class="time-content">
                <div class="item-title">德国吉森大学（Justus Liebig University Giessen）</div>
                <div class="item-desc">国际合作交流与访问学者研究</div>
              </div>
            </div>
            <div class="timeline-item">
              <div class="time-tag">1996.09 – 1999.06</div>
              <div class="time-content">
                <div class="item-title">扬州大学农学院</div>
                <div class="item-desc">植物生理学专业 · 农学硕士学位</div>
              </div>
            </div>
            <div class="timeline-item">
              <div class="time-tag">1992.09 – 1996.07</div>
              <div class="time-content">
                <div class="item-title">扬州大学农学院</div>
                <div class="item-desc">土壤与植物营养专业 · 农学学士学位</div>
              </div>
            </div>
          </div>
        </div>

        <!-- 工作经历 -->
        <div class="timeline-category">
          <div class="category-heading">
            <span class="cat-dot primary"></span>
            <h4>工作与任职历程</h4>
          </div>
          <div class="timeline-list">
            <div class="timeline-item highlight">
              <div class="time-tag">2011.08 – 至今</div>
              <div class="time-content">
                <div class="item-title">扬州大学环境科学与工程学院</div>
                <div class="item-desc">教授、博士生导师 · 现任院长 · 环境科学与工程一级学科带头人 · 环境科学研究所所长</div>
              </div>
            </div>
            <div class="timeline-item">
              <div class="time-tag">2008.03 – 2013.05</div>
              <div class="time-content">
                <div class="item-title">扬州大学化学化工学院</div>
                <div class="item-desc">博士后研究经历（材料与应用化学方向交叉）</div>
              </div>
            </div>
            <div class="timeline-item">
              <div class="time-tag">2006.07 – 2011.07</div>
              <div class="time-content">
                <div class="item-title">扬州大学环境科学与工程学院</div>
                <div class="item-desc">副教授</div>
              </div>
            </div>
            <div class="timeline-item">
              <div class="time-tag">2003.08 – 2006.07</div>
              <div class="time-content">
                <div class="item-title">扬州大学环境科学与工程学院</div>
                <div class="item-desc">讲师</div>
              </div>
            </div>
            <div class="timeline-item">
              <div class="time-tag">1999.07 – 2003.08</div>
              <div class="time-content">
                <div class="item-title">扬州大学农学院农学系</div>
                <div class="item-desc">助教、讲师</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. 社会兼职与荣誉称号 -->
    <section class="profile-section-box">
      <div class="section-badge-title">
        <span class="badge-icon">🎖️</span>
        <h3>社会兼职与荣誉称号</h3>
      </div>
      <div class="honors-grid">
        <div class="honor-card">
          <div class="honor-header">
            <span class="honor-icon">🏛️</span>
            <h4>学术兼职与专业委员会</h4>
          </div>
          <ul class="honor-list">
            <li><strong>中国土壤学会</strong> 理事</li>
            <li><strong>江苏省环境科学学会</strong> 理事</li>
            <li><strong>国家科技部重点研发计划</strong> 专项会评专家</li>
            <li><strong>《农业资源与环境学报》</strong> 编委会委员</li>
            <li><strong>国际权威顶刊特邀审稿人</strong>：<em>JACS</em>、<em>Environ. Sci. Technol.</em>、<em>Water Research</em>、<em>Adv. Mater.</em>、<em>Appl. Catal. B</em>、<em>CEJ</em> 等</li>
          </ul>
        </div>

        <div class="honor-card">
          <div class="honor-header">
            <span class="honor-icon">🏆</span>
            <h4>人才工程与科研教学荣誉</h4>
          </div>
          <ul class="honor-list">
            <li><strong>江苏省“六大人才高峰”</strong> 节能环保创新团队带头人</li>
            <li><strong>江苏省“333高层次人才培养工程”</strong> 中青年科学技术带头人</li>
            <li><strong>江苏省高校“青蓝工程”</strong> 中青年学术带头人</li>
            <li><strong>江苏省科技进步奖三等奖</strong>（第一完成人）</li>
            <li><strong>江苏省高等教育教学成果奖二等奖</strong>（2次）</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- 3. 主讲课程与育人培养 -->
    <section class="profile-section-box">
      <div class="section-badge-title">
        <span class="badge-icon">📚</span>
        <h3>主讲课程与人才培养</h3>
      </div>
      <div class="teaching-grid">
        <div class="teaching-col">
          <h4 class="col-title">🎓 本科生核心课程</h4>
          <div class="course-cards-wrap">
            <div class="course-pill-card">
              <span class="c-code">专业核心</span>
              <span class="c-name">环境化学 (Environmental Chemistry)</span>
            </div>
            <div class="course-pill-card">
              <span class="c-code">专业基础</span>
              <span class="c-name">环境学 (Environmental Science)</span>
            </div>
            <div class="course-pill-card">
              <span class="c-code">前沿拓展</span>
              <span class="c-name">固体废物处理与资源化 (Solid Waste Management)</span>
            </div>
            <div class="course-pill-card">
              <span class="c-code">专业应用</span>
              <span class="c-name">环境影响评价与规划 (EIA & Planning)</span>
            </div>
          </div>
        </div>

        <div class="teaching-col">
          <h4 class="col-title">🔬 研究生前沿课程与学术培养</h4>
          <div class="course-cards-wrap">
            <div class="course-pill-card">
              <span class="c-code master">硕士/博士</span>
              <span class="c-name">土壤生物地球化学循环 (Soil Biogeochemistry)</span>
            </div>
            <div class="course-pill-card">
              <span class="c-code master">学术前沿</span>
              <span class="c-name">高等环境化学 (Advanced Environmental Chemistry)</span>
            </div>
            <div class="course-pill-card">
              <span class="c-code master">科研方法</span>
              <span class="c-name">现代环境科学与工程实验技术与规范</span>
            </div>
          </div>
          <div class="mentorship-quote">
            <p><strong>育人理念：</strong>深怀家国情怀，求真务实创新；推动科教融合与前沿实验实践，悉心指导硕士生与博士生开展高水平原创科研，课题组累计已培养 50 余位优秀硕博毕业生。</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. 代表性科研项目 -->
    <section class="profile-section-box">
      <div class="section-badge-title">
        <span class="badge-icon">🔬</span>
        <h3>主持代表性重大科研项目</h3>
      </div>
      <div class="projects-grid">
        <div class="project-box">
          <div class="proj-badge nsfc">国家级重点科研</div>
          <h4 class="proj-name">国家自然科学基金面上项目（累计主持 4 项）</h4>
          <p class="proj-desc">长期针对农田土壤重金属生物有效性、界面配位吸附机理、微界面化学行为及原位阻控机制开展深层次基础理论突破。</p>
        </div>

        <div class="project-box">
          <div class="proj-badge keyproj">国家重点研发计划</div>
          <h4 class="proj-name">国家重点研发计划专项课题 / 子课题</h4>
          <p class="proj-desc">主导与参与面向农业面源污染防控、重金属污染农田安全利用与综合修复技术的国家重大科技攻关。</p>
        </div>

        <div class="project-box">
          <div class="proj-badge province">省部级重点</div>
          <h4 class="proj-name">江苏省农业科技自主创新资金与自然科学基金</h4>
          <p class="proj-desc">研发多功能生物炭基功能材料与水土生态调理剂，突破农林生物质固废高效清洁炭化与肥力提升关键技术。</p>
        </div>

        <div class="project-box">
          <div class="proj-badge talent">省创新团队</div>
          <h4 class="proj-name">江苏省“六大人才高峰”高层次创新团队项目</h4>
          <p class="proj-desc">带领“节能环保新型环境功能材料创新团队”，重点攻关环境光催化还原 CO₂、微污染物深度氧化降解关键技术及工程示范。</p>
        </div>
      </div>
    </section>

    <!-- 核心研究方向 -->
    <section class="profile-section-box">
      <div class="section-badge-title">
        <span class="badge-icon">🌐</span>
        <h3>核心研究方向与前沿创新</h3>
      </div>
      <div class="research-fields-grid">
        <div class="field-box">
          <div class="field-number">01</div>
          <div class="field-titles">
            <h4>水土环境修复与污染控制</h4>
            <span class="en-sub">Soil & Water Remediation</span>
          </div>
          <p class="field-desc">
            聚焦农田土壤重金属污染钝化与原位生态修复，研发新型高效阻控材料，系统治理农业面源污染，保障农产品质量与水生态安全。
          </p>
          <div class="field-tags">
            <span class="tag">重金属钝化</span>
            <span class="tag">原位修复</span>
            <span class="tag">面源污染防控</span>
          </div>
        </div>

        <div class="field-box">
          <div class="field-number">02</div>
          <div class="field-titles">
            <h4>先进催化与环境功能材料</h4>
            <span class="en-sub">Catalysis & Advanced Materials</span>
          </div>
          <p class="field-desc">
            开展单原子催化剂精准构建及其在微污染物深度降解中的机制研究；开发高效半导体光催化体系，实现光驱动 CO₂ 转化与能源重整。
          </p>
          <div class="field-tags">
            <span class="tag">单原子催化</span>
            <span class="tag">光催化还原CO₂</span>
            <span class="tag">高活性位点</span>
          </div>
        </div>

        <div class="field-box">
          <div class="field-number">03</div>
          <div class="field-titles">
            <h4>土壤碳氮循环与全球变化</h4>
            <span class="en-sub">Carbon & Nitrogen Cycling</span>
          </div>
          <p class="field-desc">
            揭示全球气候变化背景下农田土壤碳氮生物地球化学循环过程，探明温室气体产生与减排机制，解析土壤碳固存及其微生物驱动机制。
          </p>
          <div class="field-tags">
            <span class="tag">温室气体减排</span>
            <span class="tag">土壤碳固存</span>
            <span class="tag">微生物群落</span>
          </div>
        </div>

        <div class="field-box">
          <div class="field-number">04</div>
          <div class="field-titles">
            <h4>农业废弃物处置与资源化</h4>
            <span class="en-sub">Waste Recycling & Biochar</span>
          </div>
          <p class="field-desc">
            研发农林秸秆等有机废弃物高效热解炭化与改性技术，创制多功能生物炭基调理剂与新型水凝胶材料，推进固体废弃物高值化循环利用。
          </p>
          <div class="field-tags">
            <span class="tag">生物炭改性</span>
            <span class="tag">固废高值转化</span>
            <span class="tag">生态水凝胶</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 主要发表期刊墙 -->
    <section class="profile-section-box">
      <div class="section-badge-title">
        <span class="badge-icon">📚</span>
        <h3>主要代表作发表期刊</h3>
      </div>
      <div class="journal-tags-cloud">
        <span class="journal-badge highlight">Environ. Sci. Technol. (ES&T)</span>
        <span class="journal-badge highlight">Angewandte Chemie Int. Ed.</span>
        <span class="journal-badge highlight">Water Research</span>
        <span class="journal-badge">Advanced Science</span>
        <span class="journal-badge">ACS Catalysis</span>
        <span class="journal-badge">ACS Nano</span>
        <span class="journal-badge">Applied Catalysis B: Environment and Energy</span>
        <span class="journal-badge">Chemical Engineering Journal</span>
        <span class="journal-badge">Journal of Hazardous Materials</span>
        <span class="journal-badge">Bioresource Technology</span>
        <span class="journal-badge">Science of The Total Environment</span>
      </div>
    </section>

    <!-- 底部课题组互联导航 -->
    <div class="profile-bottom-nav">
      <a href="/publications" class="nav-card-link">
        <span class="icon">📖</span>
        <div class="text">
          <div class="title">浏览学术文章 (200+ 篇)</div>
          <div class="desc">查看王小治课题组完整 Clarivate WoS 核心成果库</div>
        </div>
        <span class="arrow">›</span>
      </a>
      <a href="/patents" class="nav-card-link">
        <span class="icon">🛡️</span>
        <div class="text">
          <div class="title">查看国家专利 (60+ 项)</div>
          <div class="desc">检索国家知识产权局全景技术成果</div>
        </div>
        <span class="arrow">›</span>
      </a>
