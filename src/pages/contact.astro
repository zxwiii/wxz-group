---
import Layout from '../layouts/Layout.astro';
---

<Layout title="联系我们" activeNav="contact">
  <!-- 用户原版联系我们.txt (无损嵌入) -->
  <div class="jz_fix_ue_img">
    <div style="text-align:center;padding:40px 0 30px;">
        <div style="display:inline-flex;align-items:center;gap:12px;margin-bottom:14px;">
            <span style="display:block;width:40px;height:2px;background:linear-gradient(to right, transparent, #0e8faa);"></span><span style="font-size:0.85rem;color:#0e8faa;letter-spacing:4px;font-weight:500;">CONTACT&nbsp;US</span><span style="display:block;width:40px;height:2px;background:linear-gradient(to left, transparent, #0e8faa);"></span>
 &nbsp;
        </div>
        <h2 style="font-size:2.2rem;font-weight:700;color:#0f172a;margin:0;letter-spacing:6px;line-height:1;">
            联系我们
        </h2>
        <div style="margin:16px auto 0;width:50px;height:4px;border-radius:2px;background:linear-gradient(to right, #0e8faa, #22d3ee);">
        </div>
    </div>
    <div style="max-width:900px;margin:0 auto;padding:0 20px 60px;font-family:&#39;Helvetica Neue&#39;, Helvetica, Arial, sans-serif;display:flex;gap:48px;align-items:flex-start;flex-wrap:wrap;">
        <div style="flex:1;min-width:220px;padding-top:8px;">
            <p style="font-size:2rem;font-weight:700;color:#0f172a;margin:0 0 16px;line-height:1.2;">
                期待与您合作。
            </p>
            <p style="font-size:0.97rem;color:#475569;line-height:1.8;margin:0 0 28px;">
                如您有意向开展合作、学术交流，或希望加入课题组，欢迎随时与我们取得联系。
            </p><a href="https://maps.app.goo.gl/UVJvaHSABUWxmBq7A" _t="103" _i="AGcI/////w8SKWh0dHBzOi8vbWFwcy5hcHAuZ29vLmdsL1VWSnZhSFNBQlVXeG1CcTdBGAA=" _n="https%3A%2F%2Fmaps.app.goo.gl%2FUVJvaHSABUWxmBq7A" target="_blank" astyle_h="1" style="display:flex;align-items:center;gap:8px;font-size:0.95rem;font-weight:500;color:#0E8FAA !important;text-decoration:none !important;margin-bottom:12px;" _srchref="https://maps.app.goo.gl/UVJvaHSABUWxmBq7A"> &nbsp;<span style="font-size:1rem;"></span>&nbsp;查看地图导航&nbsp;»</a><a href="https://hjxy.yzu.edu.cn/" target="_blank" style="display:flex;align-items:center;gap:8px;color:#0e8faa !important;text-decoration:none !important;font-size:0.95rem;font-weight:500;"> &nbsp;<span style="font-size:1rem;"></span>&nbsp;访问学院官网&nbsp;»</a>
 &nbsp;
        </div>
        <div style="flex:1.2;min-width:260px;border:1px solid #e2e8f0;border-radius:12px;overflow:hidden;box-shadow:0 2px 12px rgba(15,23,42,0.06);">
            <div style="padding:24px 28px;text-align:center;border-bottom:1px solid #e2e8f0;">
                <h3 style="font-size:1.05rem;font-weight:600;color:#0e8faa;margin:0 0 12px;letter-spacing:2px;">
                    地址
                </h3>
                <p style="margin:0;font-size:0.92rem;color:#334155;line-height:1.8;">
                    江苏省扬州市华扬西路196号<br />
                    扬州大学环境科学与工程学院<br />
                    邮编：225009
                </p>
            </div>
            <div style="padding:24px 28px;text-align:center;border-bottom:1px solid #e2e8f0;">
                <h3 style="font-size:1.05rem;font-weight:600;color:#0e8faa;margin:0 0 12px;letter-spacing:2px;">
                    ✉️&nbsp;邮箱&nbsp;&amp;&nbsp;电话
                </h3>
                <p style="margin:0;font-size:0.92rem;color:#334155;line-height:1.8;">
                    邮箱：<a href="mailto:xzwang@yzu.edu.cn" style="color:#0e8faa !important;text-decoration:none !important;">xzwang@yzu.edu.cn</a><br />
                    电话：+86&nbsp;0514&nbsp;8797&nbsp;9570<br />
                    微信：Wangxiaozhi00001
                </p>
            </div>
            <div style="padding:24px 28px;text-align:center;">
                <h3 style="font-size:1.05rem;font-weight:600;color:#0e8faa;margin:0 0 12px;letter-spacing:2px;">
                    工作时间
                </h3>
                <p style="margin:0;font-size:0.92rem;color:#334155;line-height:1.8;">
                    周一&nbsp;至&nbsp;周五：8:30&nbsp;–&nbsp;17:30<br />
                    周末及法定节假日休息
                </p>
            </div>
        </div>
    </div>
</div>
</Layout>
